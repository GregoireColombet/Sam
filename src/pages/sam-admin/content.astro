  }

  .picker-preview img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .picker-preview.select-sm {
    width: 60px;
    height: 45px;
  }

  :global(#ticket-links-modal .picker-preview) {
    background: #101010 !important;
    border: 1px solid var(--admin-line) !important;
    width: 60px;
    height: 45px;
    display: grid;
