---
import AdminLayout from "@/layouts/AdminLayout.astro";
import MediaPickerControl from "@/components/admin/MediaPickerControl.astro";

export const prerender = false;

const env = Astro.locals.runtime?.env;
const db = env?.DB;
const baseMediaUrl = (env?.PUBLIC_MEDIA_BASE_URL || "/media").replace(/\/$/, "");

let news: any = null;
let tours: any[] = [];
let albums: any[] = [];
let singles: any[] = [];
let allAlbums: any[] = [];
let videos: any[] = [];
let socials: any[] = [];
let musicLinks: any[] = [];
let settings: any = null;
let mediaList: any[] = [];
let error = "";

if (db) {
  try {
    const [
      newsRow,
      toursResult,
      albumsResult,
      videosResult,
      socialsResult,
      settingsRow,
      mediaResult,
      musicLinksResult,
      albumLinksResult
    ] = await Promise.all([
      db.prepare(`select * from news_blocks where id = 1`).first<any>(),
      db.prepare(`select * from tour_dates order by starts_at_utc desc`).all<any>(),
      db.prepare(`select * from album_covers order by production_date desc`).all<any>(),
      db.prepare(`select * from video_links order by sort_order asc`).all<any>(),
      db.prepare(`select * from social_links order by sort_order asc`).all<any>(),
      db.prepare(`select * from site_settings where id = 1`).first<any>(),
      db.prepare(`select * from media_assets order by created_at desc`).all<any>(),
      db.prepare(`select * from music_platform_links order by sort_order asc`).all<any>(),
      db.prepare(`select * from album_platform_links`).all<any>()
    ]);

    news = newsRow || {
      title_en: "",
      title_zh_tw: "",
      title_zh_cn: "",
      body_en: "",
      body_zh_tw: "",
      body_zh_cn: "",
      background_media_id: null,
      countdown_at_utc: "",
      is_active: 0
    };
    tours = toursResult.results || [];
    const allAlbumLinks = albumLinksResult.results || [];
    const allMedia = mediaResult.results || [];

    allAlbums = (albumsResult.results || []).map((album: any) => {
      const media = allMedia.find((m: any) => m.id === album.image_media_id);
      return {
        ...album,
        r2_key: media ? media.r2_key : undefined,
        links: allAlbumLinks.filter((l: any) => l.album_id === album.id)
      };
    });
    albums = allAlbums.filter((a: any) => a.is_single === 0);
    singles = allAlbums.filter((a: any) => a.is_single === 1);

    videos = (videosResult.results || []).map((video: any) => {
      const media = allMedia.find((m: any) => m.id === video.thumbnail_media_id);
      return {
        ...video,
        r2_key: media ? media.r2_key : undefined
      };
    });

    socials = (socialsResult.results || []).map((soc: any) => {
      const media = allMedia.find((m: any) => m.id === soc.logo_media_id);
      return {
        ...soc,
        r2_key: media ? media.r2_key : undefined
      };
    });

    musicLinks = (musicLinksResult.results || []).map((link: any) => {
      const media = allMedia.find((m: any) => m.id === link.logo_media_id);
      return {
        ...link,
        r2_key: media ? media.r2_key : undefined
      };
    });
    settings = settingsRow || {
      merch_url_en: "",
      merch_url_zh_tw: "",
      merch_url_zh_cn: "",
      merch_is_active: 0,
      bonus_title_en: "",
      bonus_title_zh_tw: "",
      bonus_title_zh_cn: "",
      bonus_text_en: "",
      bonus_text_zh_tw: "",
      bonus_text_zh_cn: "",
      bonus_media_id: null,
      bonus_is_active: 0
    };
    mediaList = mediaResult.results || [];
  } catch (e: any) {
    error = e.message;
  }
} else {
  error = "Database is not available.";
}

function getMediaUrl(id: number | null) {
  if (!id) return "";
  const found = mediaList.find((m) => m.id === id);
  return found ? `${baseMediaUrl}/${found.r2_key}` : "";
}
---

<AdminLayout title="Content Manager">
  <div class="content-header">
    <h1>Content Manager</h1>
    <p class="admin-muted">Manage all trilingual marketing copy, tour dates, album listings, and media integrations.</p>
  </div>

  {error && <div class="admin-alert admin-alert-error">{error}</div>}

  <!-- Tab Buttons -->
  <div class="tab-buttons">
    <button class="tab-btn active" data-tab="news">News Block</button>
    <button class="tab-btn" data-tab="tours">Tour Dates</button>
    <button class="tab-btn" data-tab="albums">Music & Albums</button>
    <button class="tab-btn" data-tab="videos">Moment</button>
    <button class="tab-btn" data-tab="socials-merch">Socials & Merch</button>
    <button class="tab-btn" data-tab="bonus">Bonus page</button>
  </div>

  <!-- Tab Contents -->
  <div class="tab-contents">
    
    <!-- NEWS TAB -->
    <div class="tab-pane active" id="tab-news">
      <form id="news-form" class="admin-form card-form">
        <h2>News Banner Settings</h2>
        
        <div class="form-grid">
          <div class="form-group">
            <label>Title (English)</label>
            <input type="text" name="title_en" value={news.title_en} required />
          </div>
          <div class="form-group">
            <label>Title (Traditional Chinese)</label>
            <input type="text" name="title_zh_tw" value={news.title_zh_tw} required />
          </div>
          <div class="form-group">
            <label>Title (Simplified Chinese)</label>
            <input type="text" name="title_zh_cn" value={news.title_zh_cn} required />
          </div>
        </div>

        <div class="form-grid">
          <div class="form-group">
            <label>Body Text (English)</label>
            <textarea name="body_en" rows="3" required>{news.body_en}</textarea>
          </div>
          <div class="form-group">
            <label>Body Text (Traditional Chinese)</label>
            <textarea name="body_zh_tw" rows="3" required>{news.body_zh_tw}</textarea>
          </div>
          <div class="form-group">
            <label>Body Text (Simplified Chinese)</label>
            <textarea name="body_zh_cn" rows="3" required>{news.body_zh_cn}</textarea>
          </div>
        </div>

        <div class="form-grid">
          <div class="form-group">
            <label>Background Image</label>
            <MediaPickerControl
              field="background_media_id"
              name="background_media_id"
              value={news.background_media_id}
              previewUrl={getMediaUrl(news.background_media_id)}
            />
          </div>

          <div class="form-group">
            <label>Countdown Target (UTC Date/Time)</label>
            <input 
              type="datetime-local" 
              name="countdown_at_utc" 
              value={news.countdown_at_utc ? news.countdown_at_utc.slice(0, 16) : ""} 
            />
            <span class="field-hint">Leave blank to disable the countdown clock. Use UTC time.</span>
          </div>

          <div class="form-group row-group">
            <input type="checkbox" id="news-active" name="is_active" checked={news.is_active === 1} />
            <label for="news-active">Display News block on website</label>
          </div>
        </div>

        <button type="submit" class="btn-submit">Save News settings</button>
      </form>
    </div>

    <!-- TOURS TAB -->
    <div class="tab-pane" id="tab-tours">
      <div class="actions-bar">
        <h2>Tour Schedule</h2>
        <button class="btn-primary" id="btn-add-tour">Add Tour Date</button>
      </div>

      <table class="admin-table">
        <thead>
          <tr>
            <th>Date & Time</th>
            <th>Location (EN / 繁 / 简)</th>
            <th>Description (TW)</th>
            <th>Links</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {tours.length === 0 ? (
            <tr>
              <td colspan="6" class="admin-muted" style="text-align: center; padding: 24px;">No tour dates scheduled.</td>
            </tr>
          ) : (
            tours.map((t) => (
              <tr data-tour-id={t.id}>
                <td>
                  <strong>{t.local_date}</strong>
                  <span class="time-meta">{t.local_time} ({t.timezone})</span>
                </td>
                <td>
                  <div>EN: {t.location_en}</div>
                  <div>繁: {t.location_zh_tw}</div>
                  <div>简: {t.location_zh_cn}</div>
                </td>
                <td class="admin-muted truncate-cell">
                  {t.description_zh_tw}
                </td>
                <td>
                  <button class="btn-manage-links" data-id={t.id} data-location={t.location_zh_tw}>
                    Ticket Links
                  </button>
                </td>
                <td>
                  <span class:list={["badge", t.is_active === 1 ? "badge-active" : "badge-inactive"]}>
                    {t.is_active === 1 ? "Active" : "Hidden"}
                  </span>
                </td>
                <td>
                  <button class="btn-edit-tour" data-tour={JSON.stringify(t)}>Edit</button>
                  <button class="btn-delete-tour delete-btn" data-id={t.id}>Delete</button>
                </td>
              </tr>
            ))
          )}
        </tbody>
      </table>
    </div>

    <!-- ALBUMS TAB -->
    <div class="tab-pane" id="tab-albums">
      <div class="card-form">
        <div class="actions-bar">
          <h2>Music Streaming Platforms</h2>
          <button type="button" class="btn-primary" id="btn-add-music">Add Music Platform</button>
        </div>
        <p class="admin-muted">Add streaming platforms (e.g. Spotify, Apple Music) displayed on the music page. Select logo PNGs/SVGs and input URLs.</p>

        <table class="admin-table">
          <thead>
            <tr>
              <th>Logo</th>
              <th>Platform Name</th>
              <th>Target URL</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {musicLinks.map((link) => (
              <tr data-music-id={link.id}>
                <td>
                  <div class="picker-preview select-sm thumb-preview-box">
                    <img src={getMediaUrl(link.logo_media_id)} alt={link.name} class="contain-img" />
                  </div>
                </td>
                <td><strong>{link.name}</strong></td>
                <td><a href={link.url} target="_blank" class="table-link">Link</a></td>
                <td>
                  <span class:list={["badge", link.is_active === 1 ? "badge-active" : "badge-inactive"]}>
                    {link.is_active === 1 ? "Active" : "Hidden"}
                  </span>
                </td>
                <td>
                  <button class="btn-edit-music" data-music={JSON.stringify(link)}>Edit</button>
                  <button class="btn-delete-music delete-btn" data-id={link.id}>Delete</button>
                </td>
              </tr>
            ))}
            {musicLinks.length === 0 && (
              <tr>
                <td colspan="5" class="admin-muted" style="text-align: center; padding: 24px;">No music platform links configured.</td>
              </tr>
            )}
          </tbody>
        </table>
      </div>

      <div class="card-form" style="margin-top: 2rem;">
        <div class="actions-bar">
          <h2>Album Covers (Mosaic Grid)</h2>
          <button type="button" class="btn-primary" id="btn-add-album">Add album</button>
        </div>
        <p class="admin-muted">Add album covers here. Order is set by release date. Albums link to the public Music page.</p>

        <table class="admin-table">
          <thead>
            <tr>
              <th>Cover</th>
              <th>Album Title</th>
              <th>Release Date</th>
              <th>Platform Links</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {albums.map((album) => (
              <tr data-album-id={album.id}>
                <td>
                  <div class="picker-preview select-sm thumb-preview-box" style="width: 50px; height: 50px;">
                    <img src={getMediaUrl(album.image_media_id)} alt={album.title} class="contain-img" />
                  </div>
                </td>
                <td><strong>{album.title}</strong></td>
                <td><code class="date-tag">{album.production_date || album.productionDate}</code></td>
                <td>
                  <div class="album-links-col">
                    {album.links && album.links.length > 0 ? (
                      album.links.map((l: any) => {
                        const plat = musicLinks.find((p) => p.id === l.platform_id || p.id === l.platformId);
                        return <div><strong>{plat ? plat.name : "Platform"}:</strong> <a href={l.url} target="_blank" class="table-link">Link</a></div>;
                      })
                    ) : (
                      <span class="admin-muted">No custom links</span>
                    )}
                  </div>
                </td>
                <td>
                  <button class="btn-edit-album" data-album={JSON.stringify(album)}>Edit</button>
                  <button class="btn-delete-album delete-btn" data-id={album.id}>Delete</button>
                </td>
              </tr>
            ))}
            {albums.length === 0 && (
              <tr>
                <td colspan="5" class="admin-muted" style="text-align: center; padding: 24px;">No album covers configured.</td>
              </tr>
            )}
          </tbody>
        </table>
      </div>

      <div class="card-form" style="margin-top: 2rem;">
        <div class="actions-bar">
          <h2>Single Covers</h2>
          <button type="button" class="btn-primary" id="btn-add-single">Add single</button>
        </div>
        <p class="admin-muted">Add single covers here. Order is set by release date. Singles link to the public Music page.</p>

        <table class="admin-table">
          <thead>
            <tr>
              <th>Cover</th>
              <th>Single Title</th>
              <th>Release Date</th>
              <th>Platform Links</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {singles.map((single) => (
              <tr data-album-id={single.id}>
                <td>
                  <div class="picker-preview select-sm thumb-preview-box" style="width: 50px; height: 50px;">
                    <img src={getMediaUrl(single.image_media_id)} alt={single.title} class="contain-img" />
                  </div>
                </td>
                <td><strong>{single.title}</strong></td>
                <td><code class="date-tag">{single.production_date || single.productionDate}</code></td>
                <td>
                  <div class="album-links-col">
                    {single.links && single.links.length > 0 ? (
                      single.links.map((l: any) => {
                        const plat = musicLinks.find((p) => p.id === l.platform_id || p.id === l.platformId);
                        return <div><strong>{plat ? plat.name : "Platform"}:</strong> <a href={l.url} target="_blank" class="table-link">Link</a></div>;
                      })
                    ) : (
                      <span class="admin-muted">No custom links</span>
                    )}
                  </div>
                </td>
                <td>
                  <button class="btn-edit-album" data-album={JSON.stringify(single)}>Edit</button>
                  <button class="btn-delete-album delete-btn" data-id={single.id}>Delete</button>
                </td>
              </tr>
            ))}
            {singles.length === 0 && (
              <tr>
                <td colspan="5" class="admin-muted" style="text-align: center; padding: 24px;">No single covers configured.</td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </div>

    <!-- VIDEOS TAB (MOMENT) -->
    <div class="tab-pane" id="tab-videos">
      <div class="card-form">
        <div class="actions-bar">
          <h2>Carousel Playable Moments</h2>
          <button type="button" class="btn-primary" id="btn-add-video">Add Moment</button>
        </div>
        <p class="admin-muted">Set up playable moments. Select a video from your uploaded video assets and choose an image for its thumbnail cover.</p>

        <table class="admin-table">
          <thead>
            <tr>
              <th>Thumbnail</th>
              <th>Video Title</th>
              <th>Video File</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {videos.map((vid) => (
              <tr data-video-id={vid.id}>
                <td>
                  <div class="picker-preview select-sm thumb-preview-box" style="width: 50px; height: 50px;">
                    {vid.thumbnail_media_id ? (
                      <img src={getMediaUrl(vid.thumbnail_media_id)} alt={vid.title} class="contain-img" />
                    ) : (
                      <span class="no-img">No Image</span>
                    )}
                  </div>
                </td>
                <td><strong>{vid.title}</strong></td>
                <td><span class="admin-muted" style="font-size: 0.85rem; word-break: break-all;">{vid.url_en ? vid.url_en.split("/").pop() : "No video file"}</span></td>
                <td>
                  <span class:list={["badge", vid.is_active === 1 ? "badge-active" : "badge-inactive"]}>
                    {vid.is_active === 1 ? "Active" : "Hidden"}
                  </span>
                </td>
                <td>
                  <button class="btn-edit-video" data-video={JSON.stringify(vid)}>Edit</button>
                  <button class="btn-delete-video delete-btn" data-id={vid.id}>Delete</button>
                </td>
              </tr>
            ))}
            {videos.length === 0 && (
              <tr>
                <td colspan="5" class="admin-muted" style="text-align: center; padding: 24px;">No moments configured.</td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </div>

    <!-- SOCIALS & MERCH TAB -->
    <div class="tab-pane" id="tab-socials-merch">
      <form id="merch-form" class="admin-form card-form mb-4">
        <h2>Merchandising External Shop Settings</h2>
        <p class="admin-muted">Configure external shops (e.g. Shopee, Shopify) per language. If inactive, the public shop link redirects to "Coming soon".</p>
        
        <div class="form-grid">
          <div class="form-group">
            <label>Shop URL (English)</label>
            <input type="url" name="merch_url_en" value={settings.merch_url_en} placeholder="https://..." />
          </div>
          <div class="form-group">
            <label>Shop URL (Traditional Chinese)</label>
            <input type="url" name="merch_url_zh_tw" value={settings.merch_url_zh_tw} placeholder="https://..." />
          </div>
          <div class="form-group">
            <label>Shop URL (Simplified Chinese)</label>
            <input type="url" name="merch_url_zh_cn" value={settings.merch_url_zh_cn} placeholder="https://..." />
          </div>
        </div>

        <div class="form-group">
          <label style="margin-bottom: 6px; display: block;">Merchandising Status</label>
          <div class="switch-container">
            <label class="switch-toggle-label">
              <input type="checkbox" id="merch-active" name="merch_is_active" checked={settings.merch_is_active === 1} />
              <div class="switch-layout">
                <span class="switch-label text-disabled">Disabled</span>
                <div class="switch-slider-track">
                  <span class="switch-slider-thumb"></span>
                </div>
                <span class="switch-label text-available">Available</span>
              </div>
            </label>
          </div>
        </div>

        <button type="submit" class="btn-submit">Save Merch Settings</button>
      </form>

      <div class="card-form">
        <div class="actions-bar">
          <h2>Footer Social Platforms</h2>
          <button type="button" class="btn-primary" id="btn-add-social">Add Platform</button>
        </div>
        <p class="admin-muted">Add social links displayed in the footer. Upload clean, colored or monochrome logo PNG/SVGs to R2 and reference them below.</p>

        <table class="admin-table">
          <thead>
            <tr>
              <th>Logo</th>
              <th>Platform Name</th>
              <th>Target URL</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {socials.map((soc) => (
              <tr data-social-id={soc.id}>
                <td>
                  <div class="picker-preview select-sm thumb-preview-box">
                    <img src={getMediaUrl(soc.logo_media_id)} alt={soc.name} class="contain-img" />
                  </div>
                </td>
                <td><strong>{soc.name}</strong></td>
                <td><a href={soc.url} target="_blank" class="table-link">Link</a></td>
                <td>
                  <span class:list={["badge", soc.is_active === 1 ? "badge-active" : "badge-inactive"]}>
                    {soc.is_active === 1 ? "Active" : "Hidden"}
                  </span>
                </td>
                <td>
                  <button class="btn-edit-social" data-social={JSON.stringify(soc)}>Edit</button>
                  <button class="btn-delete-social delete-btn" data-id={soc.id}>Delete</button>
                </td>
              </tr>
            ))}
            {socials.length === 0 && (
              <tr>
                <td colspan="5" class="admin-muted" style="text-align: center; padding: 24px;">No social platforms configured.</td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </div>

    <!-- BONUS TAB -->
    <div class="tab-pane" id="tab-bonus">
      <form id="bonus-form" class="admin-form card-form">
        <h2>Bonus Page Settings</h2>
        <p class="admin-muted">Manage the Title, Text, and Image displayed when clicking the "Extra bonus" button.</p>

        <div class="form-grid">
          <div class="form-group">
            <label>Title (English)</label>
            <input type="text" name="bonus_title_en" value={settings.bonus_title_en || ""} required />
          </div>
          <div class="form-group">
            <label>Title (Traditional Chinese)</label>
            <input type="text" name="bonus_title_zh_tw" value={settings.bonus_title_zh_tw || ""} required />
          </div>
          <div class="form-group">
            <label>Title (Simplified Chinese)</label>
            <input type="text" name="bonus_title_zh_cn" value={settings.bonus_title_zh_cn || ""} required />
          </div>
        </div>

        <div class="form-grid">
          <div class="form-group">
            <label>Text (English)</label>
            <textarea name="bonus_text_en" rows="3" required>{settings.bonus_text_en || ""}</textarea>
          </div>
          <div class="form-group">
            <label>Text (Traditional Chinese)</label>
            <textarea name="bonus_text_zh_tw" rows="3" required>{settings.bonus_text_zh_tw || ""}</textarea>
          </div>
          <div class="form-group">
            <label>Text (Simplified Chinese)</label>
            <textarea name="bonus_text_zh_cn" rows="3" required>{settings.bonus_text_zh_cn || ""}</textarea>
          </div>
        </div>

        <div class="form-grid">
          <div class="form-group">
            <label>Bonus Image</label>
            <MediaPickerControl
              field="bonus_media_id"
              name="bonus_media_id"
              value={settings.bonus_media_id}
              previewUrl={getMediaUrl(settings.bonus_media_id)}
            />
          </div>
        </div>

        <div class="form-grid">
          <div class="form-group checkbox-cell" style="margin-top: 0; align-self: start;">
            <div class="row-group">
              <input type="checkbox" id="bonus-active" name="bonus_is_active" checked={settings.bonus_is_active === 1} />
              <label for="bonus-active" style="text-transform: none; font-size: 0.95rem; font-weight: normal; cursor: pointer;">Bonus Page Active (show loading bar and button)</label>
            </div>
          </div>
        </div>

        <button type="submit" class="btn-submit">Save Bonus Settings</button>
      </form>
    </div>

  </div>

  <!-- MEDIA PICKER MODAL -->
  <div class="admin-modal" id="media-picker-modal">
    <div class="modal-content">
      <header class="modal-header">
        <h3>Select Media Asset</h3>
        <button type="button" class="btn-close-modal" id="btn-close-media-modal">&times;</button>
      </header>
      <div class="modal-body">
        <div class="media-search-bar">
          <input type="text" id="media-search-input" placeholder="Search files by name..." />
        </div>
        <div class="modal-media-grid" id="modal-media-grid">
          {mediaList.map((m) => (
            <div class="modal-media-item" data-id={m.id} data-url={`${baseMediaUrl}/${m.r2_key}`} data-name={m.file_name} data-media-type={m.content_type.startsWith("video/") ? "video" : "image"}>
              {m.content_type.startsWith("video/") ? (
                <div class="video-placeholder-preview">
                  <span style="font-size: 1.5rem;">📹</span>
                </div>
              ) : (
                <img src={`${baseMediaUrl}/${m.r2_key}`} alt={m.alt_text || m.file_name} />
              )}
              <span class="modal-item-name" title={m.file_name}>{m.file_name}</span>
            </div>
          ))}
          {mediaList.length === 0 && <div class="admin-muted" style="grid-column: 1/-1; text-align: center; padding: 24px;">No media assets available. Go to the Media Library to upload files first.</div>}
        </div>
      </div>
    </div>
  </div>

  <!-- TOUR EDITOR MODAL -->
  <div class="admin-modal" id="tour-editor-modal">
    <div class="modal-content modal-lg">
      <header class="modal-header">
        <h3 id="tour-modal-title">Add Tour Date</h3>
        <button type="button" class="btn-close-modal" id="btn-close-tour-modal">&times;</button>
      </header>
      <div class="modal-body">
        <form id="tour-editor-form" class="admin-form">
          <input type="hidden" name="id" id="tour-id" />
          
          <div class="form-grid">
            <div class="form-group">
              <label for="tour-local-date">Local Date</label>
              <input type="date" id="tour-local-date" name="local_date" required />
            </div>
            <div class="form-group">
              <label for="tour-local-time">Local Time</label>
              <input type="time" id="tour-local-time" name="local_time" required />
            </div>
            <div class="form-group">
              <label for="tour-timezone">Timezone</label>
              <select id="tour-timezone" name="timezone" required>
                <option value="Asia/Taipei" selected>Asia/Taipei</option>
                <option value="Asia/Hong_Kong">Asia/Hong_Kong</option>
                <option value="Asia/Shanghai">Asia/Shanghai</option>
                <option value="Asia/Singapore">Asia/Singapore</option>
                <option value="Asia/Tokyo">Asia/Tokyo</option>
                <option value="Asia/Seoul">Asia/Seoul</option>
                <option value="Europe/London">Europe/London</option>
                <option value="Europe/Paris">Europe/Paris</option>
                <option value="America/New_York">America/New_York</option>
                <option value="America/Los_Angeles">America/Los_Angeles</option>
                <option value="UTC">UTC</option>
              </select>
            </div>
          </div>

          <div class="form-grid">
            <div class="form-group">
              <label for="tour-loc-en">Location (English)</label>
              <input type="text" id="tour-loc-en" name="location_en" required placeholder="Legacy Taipei" />
            </div>
            <div class="form-group">
              <label for="tour-loc-tw">Location (Traditional Chinese)</label>
              <input type="text" id="tour-loc-tw" name="location_zh_tw" required placeholder="華山 Legacy Taipei" />
            </div>
            <div class="form-group">
              <label for="tour-loc-cn">Location (Simplified Chinese)</label>
              <input type="text" id="tour-loc-cn" name="location_zh_cn" required placeholder="华山 Legacy Taipei" />
            </div>
          </div>

          <div class="form-grid">
            <div class="form-group">
              <label for="tour-desc-en">Description (English)</label>
              <textarea id="tour-desc-en" name="description_en" rows="2" required></textarea>
            </div>
            <div class="form-group">
              <label for="tour-desc-tw">Description (Traditional Chinese)</label>
              <textarea id="tour-desc-tw" name="description_zh_tw" rows="2" required></textarea>
            </div>
            <div class="form-group">
              <label for="tour-desc-cn">Description (Simplified Chinese)</label>
              <textarea id="tour-desc-cn" name="description_zh_cn" rows="2" required></textarea>
            </div>
          </div>

          <div class="form-group row-group">
            <input type="checkbox" id="tour-active" name="is_active" checked />
            <label for="tour-active">Active (Visible on landing page)</label>
          </div>

          <div class="modal-footer-buttons">
            <button type="button" class="btn-secondary" id="btn-cancel-tour">Cancel</button>
            <button type="submit" class="btn-submit" id="btn-save-tour" style="margin: 0;">Save Tour Date</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- MUSIC EDITOR MODAL -->
  <div class="admin-modal" id="music-editor-modal">
    <div class="modal-content">
      <header class="modal-header">
        <h3 id="music-modal-title">Add Music Platform</h3>
        <button type="button" class="btn-close-modal" id="btn-close-music-modal">&times;</button>
      </header>
      <div class="modal-body">
        <form id="music-editor-form" class="admin-form">
          <input type="hidden" name="id" id="music-id" />
          
          <div class="form-group">
            <label for="music-name">Platform Name</label>
            <input type="text" id="music-name" name="name" placeholder="e.g. Spotify, Apple Music" required />
          </div>

          <div class="form-group">
            <label for="music-url">Target URL</label>
            <input type="url" id="music-url" name="url" placeholder="https://..." required />
          </div>

          <div class="form-group">
            <label>Logo Icon</label>
            <MediaPickerControl
              field="music-logo-picker"
              name="logo_media_id"
              idPrefix="music-logo"
              selectButtonText="Select"
              small={true}
            />
          </div>

          <div class="form-group row-group">
            <input type="checkbox" id="music-active" name="is_active" checked />
            <label for="music-active">Active (Visible on music page)</label>
          </div>

          <div class="modal-footer-buttons">
            <button type="button" class="btn-secondary" id="btn-cancel-music">Cancel</button>
            <button type="submit" class="btn-submit" id="btn-save-music" style="margin: 0;">Save</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- ALBUM EDITOR MODAL -->
  <div class="admin-modal" id="album-editor-modal">
    <div class="modal-content modal-lg">
      <header class="modal-header">
        <h3 id="album-modal-title">Add Album Cover</h3>
        <button type="button" class="btn-close-modal" id="btn-close-album-modal">&times;</button>
      </header>
      <div class="modal-body">
        <form id="album-editor-form" class="admin-form">
          <input type="hidden" name="id" id="album-id" />
          
          <div class="form-grid">
            <div class="form-group">
              <label for="album-title">Album Title</label>
              <input type="text" id="album-title" name="title" required />
            </div>

            <div class="form-group">
              <label for="album-date">Release Date</label>
              <input type="date" id="album-date" name="production_date" required />
            </div>

            <div class="form-group">
              <label>Cover Image</label>
              <MediaPickerControl
                field="album-cover-picker"
                name="image_media_id"
                idPrefix="album-image"
                selectButtonText="Select"
                small={true}
              />
            </div>
          </div>

          <div class="form-group row-group">
            <input type="checkbox" id="album-single" name="is_single" checked />
            <label for="album-single">Single album (if not checked it is an album)</label>
          </div>

          <div class="album-platform-links-section">
            <h4>Platform Custom Links</h4>
            <div class="album-links-list" id="modal-album-links-list">
              {musicLinks.map((platform) => (
                <div class="album-platform-link-row" data-platform-id={platform.id}>
                  <span class="platform-row-name">{platform.name}</span>
                  <input type="url" class="album-platform-url" placeholder="https://... (leave blank to omit)" />
                </div>
              ))}
            </div>
          </div>

          <div class="modal-footer-buttons">
            <button type="button" class="btn-secondary" id="btn-cancel-album">Cancel</button>
            <button type="submit" class="btn-submit" id="btn-save-album" style="margin: 0;">Save</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- VIDEO EDITOR MODAL -->
  <div class="admin-modal" id="video-editor-modal">
    <div class="modal-content modal-lg">
      <header class="modal-header">
        <h3 id="video-modal-title">Add Moment</h3>
        <button type="button" class="btn-close-modal" id="btn-close-video-modal">&times;</button>
      </header>
      <div class="modal-body">
        <form id="video-editor-form" class="admin-form">
          <input type="hidden" name="id" id="video-id" />
          
          <div class="form-grid">
            <div class="form-group">
              <label for="video-title">Video Title</label>
              <input type="text" id="video-title" name="title" required />
            </div>

            <div class="form-group">
              <label>Thumbnail Cover</label>
              <MediaPickerControl
                field="video-thumb-picker"
                name="thumbnail_media_id"
                idPrefix="video-thumbnail"
                mediaType="image"
                selectButtonText="Select"
                small={true}
              />
            </div>
          </div>

          <div class="form-group">
            <label>Choose Video File (Cloudflare)</label>
            <MediaPickerControl
              field="video-asset-picker"
              name="url_en"
              idPrefix="video-asset"
              mediaType="video"
              selectButtonText="Select Video"
            />
          </div>

          <div class="form-group row-group">
            <input type="checkbox" id="video-active" name="is_active" checked />
            <label for="video-active">Active (Visible on landing page)</label>
          </div>

          <div class="modal-footer-buttons">
            <button type="button" class="btn-secondary" id="btn-cancel-video">Cancel</button>
            <button type="submit" class="btn-submit" id="btn-save-video" style="margin: 0;">Save</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- SOCIAL EDITOR MODAL -->
  <div class="admin-modal" id="social-editor-modal">
    <div class="modal-content">
      <header class="modal-header">
        <h3 id="social-modal-title">Add Footer Social Platform</h3>
        <button type="button" class="btn-close-modal" id="btn-close-social-modal">&times;</button>
      </header>
      <div class="modal-body">
        <form id="social-editor-form" class="admin-form">
          <input type="hidden" name="id" id="social-id" />
          
          <div class="form-group">
            <label for="social-name">Platform Name</label>
            <input type="text" id="social-name" name="name" placeholder="e.g. YouTube, Instagram" required />
          </div>

          <div class="form-group">
            <label for="social-url">Target URL</label>
            <input type="url" id="social-url" name="url" placeholder="https://..." required />
          </div>

          <div class="form-group">
            <label>Custom Logo (R2)</label>
            <MediaPickerControl
              field="social-logo-picker"
              name="logo_media_id"
              idPrefix="social-logo"
              selectButtonText="Select"
              small={true}
            />
          </div>

          <div class="form-group row-group">
            <input type="checkbox" id="social-active" name="is_active" checked />
            <label for="social-active">Active (Visible in footer)</label>
          </div>

          <div class="modal-footer-buttons">
            <button type="button" class="btn-secondary" id="btn-cancel-social">Cancel</button>
            <button type="submit" class="btn-submit" id="btn-save-social" style="margin: 0;">Save</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- TICKET LINKS MODAL -->
  <div class="admin-modal" id="ticket-links-modal">
    <div class="modal-content modal-lg">
      <header class="modal-header">
        <h3 id="ticket-modal-title">Ticket Links</h3>
        <button type="button" class="btn-close-modal" id="btn-close-ticket-modal">&times;</button>
      </header>
      <div class="modal-body">
        <p class="admin-muted">Manage platforms selling tickets for this show. Reorder or toggle status below.</p>
        <form id="ticket-links-form" class="admin-form">
          <input type="hidden" id="ticket-tour-id" />
          
          <div class="sortable-list" id="ticket-links-container"></div>
          
          <div class="pt-2" style="display: flex; gap: 12px;">
            <button type="button" class="btn-primary" id="btn-add-ticket-row">Add Platform Link</button>
            <button type="submit" class="btn-submit" style="margin-top:0;">Save Ticket Links</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- PLATFORM WARNING MODAL -->
  <div class="admin-modal" id="platform-warning-modal">
    <div class="modal-content" style="max-width: 450px;">
      <header class="modal-header">
        <h3>Platform Deletion Error</h3>
        <button type="button" class="btn-close-modal" id="btn-close-warning-modal">&times;</button>
      </header>
      <div class="modal-body" style="padding: 1.5rem; text-align: center;">
        <p id="platform-warning-message" style="color: var(--ice-white); margin-bottom: 1.5rem; line-height: 1.5; font-size: 0.95rem;">Cannot delete the platform, there are albums using it. Remove it from all albums first.</p>
        <button type="button" class="btn-primary" id="btn-close-warning-modal-ok">OK</button>
      </div>
    </div>
  </div>

  <!-- Embedded JSON data for client-side forms -->
  <script id="music-platforms-data" type="application/json" is:inline set:html={JSON.stringify(musicLinks)}></script>
  <script id="albums-data" type="application/json" is:inline set:html={JSON.stringify(allAlbums)}></script>
  <script id="videos-data" type="application/json" is:inline set:html={JSON.stringify(videos)}></script>
  <script id="socials-data" type="application/json" is:inline set:html={JSON.stringify(socials)}></script>
</AdminLayout>

<script src="./content.client.ts"></script>

