<style>
  .content-header {
    margin-bottom: 28px;
  }

  /* Tabs Navigation styling */
  .tab-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    border-bottom: 1px solid var(--admin-line);
    margin-bottom: 32px;
  }

  .tab-btn {
    min-height: 44px;
    padding: 0 20px;
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: var(--admin-muted);
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    transition: color 180ms ease, border-color 180ms ease;
  }

  .tab-btn:hover {
    color: var(--admin-text);
  }

  .tab-btn.active {
    color: #7d5b2f;
    border-color: #7d5b2f;
  }

  /* Tab panes styling */
  .tab-pane {
    display: none;
  }

  .tab-pane.active {
    display: block;
  }

  .actions-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 16px;
  }

  .actions-bar h2 {
    margin: 0;
    font-size: 1.25rem;
  }

  /* Form & card styling */
  .card-form {
    padding: 32px;
    border: 1px solid var(--admin-line);
    background: var(--admin-panel);
    box-shadow: 0 2px 8px rgba(0,0,0,0.02);
  }

  .card-form h2 {
    margin: 0 0 24px;
    font-size: 1.2rem;
  }

  .admin-form {
    display: grid;
    gap: 24px;
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }

  .form-group {
    display: grid;
    gap: 6px;
  }

  .form-group label {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--admin-text);
    letter-spacing: 0.5px;
  }

  .form-group input[type="text"],
  .form-group input[type="url"],
  .form-group input[type="datetime-local"],
  .form-group input[type="date"],
  .form-group input[type="time"],
  .form-group select,
  .form-group textarea {
    width: 100%;
    min-height: 40px;
    padding: 8px 12px;
    border: 1px solid var(--admin-line);
    background: #fff;
    font-size: 0.95rem;
    color: var(--admin-text);
  }

  .form-group textarea {
    resize: vertical;
  }

  /* Toggle Switch Styles */
  .switch-container {
    display: flex;
    align-items: center;
    margin-top: 4px;
  }

  .switch-toggle-label {
    position: relative;
    display: inline-block;
    cursor: pointer;
  }

  .switch-toggle-label input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .switch-layout {
    display: flex;
    align-items: center;
    gap: 12px;
    user-select: none;
  }

  .switch-slider-track {
    position: relative;
    width: 48px;
    height: 24px;
    background-color: #ccc;
    transition: background-color 0.2s ease;
    border-radius: 24px;
  }

  .switch-slider-thumb {
    position: absolute;
    height: 18px;
    width: 18px;
    left: 3px;
    bottom: 3px;
    background-color: white;
    transition: transform 0.2s ease;
    border-radius: 50%;
  }

  .switch-label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--admin-muted);
    transition: color 0.2s ease;
  }

  /* Checked state transitions */
  .switch-toggle-label input:checked + .switch-layout .switch-slider-track {
    background-color: #7d5b2f;
  }

  .switch-toggle-label input:checked + .switch-layout .switch-slider-thumb {
    transform: translateX(24px);
  }

  .switch-toggle-label input:not(:checked) + .switch-layout .text-disabled {
    color: var(--admin-text);
    font-weight: 700;
  }

  .switch-toggle-label input:checked + .switch-layout .text-available {
    color: #7d5b2f;
    font-weight: 700;
  }

  .row-group {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .row-group input[type="checkbox"],
  .checkbox-cell input[type="checkbox"] {
    width: 18px;
    height: 18px;
    accent-color: #7d5b2f;
  }

  .checkbox-cell {
    display: flex;
    align-items: center;
    gap: 8px;
    align-self: center;
    margin-top: 14px;
  }

  .field-hint {
    font-size: 0.78rem;
    color: var(--admin-muted);
  }

  .btn-submit {
    min-height: 44px;
    background: #7d5b2f;
    color: #fff;
    font-weight: 700;
    border: none;
