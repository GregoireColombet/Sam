    background: transparent !important;
  }

  .no-img {
    font-size: 0.7rem;
    color: var(--admin-muted);
    text-align: center;
    padding: 4px;
  }

  .picker-actions {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .btn-select-media {
    background: var(--admin-text);
    color: #fff;
    border: none;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 6px 12px;
    cursor: pointer;
