---
import AdminLayout from "@/layouts/AdminLayout.astro";

export const prerender = false;

const env = Astro.locals.runtime?.env;
const db = env?.DB;
const baseMediaUrl = (env?.PUBLIC_MEDIA_BASE_URL || "/media").replace(/\/$/, "");

let news: any = null;
let tours: any[] = [];
let albums: any[] = [];
let videos: any[] = [];
let socials: any[] = [];
let musicLinks: any[] = [];
let settings: any = null;
let mediaList: any[] = [];
let error = "";

if (db) {
  try {
    const [newsRow, toursResult, albumsResult, videosResult, socialsResult, settingsRow, mediaResult, musicLinksResult, albumLinksResult] = await Promise.all([
      db.prepare(`select * from news_blocks where id = 1`).first<any>(),
      db.prepare(`select * from tour_dates order by starts_at_utc desc`).all<any>(),
      db.prepare(`select * from album_covers order by production_date desc`).all<any>(),
      db.prepare(`select * from video_links order by sort_order asc`).all<any>(),
      db.prepare(`select * from social_links order by sort_order asc`).all<any>(),
      db.prepare(`select * from site_settings where id = 1`).first<any>(),
      db.prepare(`select * from media_assets order by created_at desc`).all<any>(),
      db.prepare(`select * from music_platform_links order by sort_order asc`).all<any>(),
      db.prepare(`select * from album_platform_links`).all<any>()
    ]);

    news = newsRow || {
      title_en: "", title_zh_tw: "", title_zh_cn: "",
      body_en: "", body_zh_tw: "", body_zh_cn: "",
      background_media_id: null, countdown_at_utc: "", is_active: 0
    };
    tours = toursResult.results || [];
    const allAlbumLinks = albumLinksResult.results || [];
    const allMedia = mediaResult.results || [];
    
    albums = (albumsResult.results || []).map((album: any) => {
      const media = allMedia.find((m: any) => m.id === album.image_media_id);
      return {
        ...album,
        r2_key: media ? media.r2_key : undefined,
        links: allAlbumLinks.filter((l: any) => l.album_id === album.id)
      };
    });
    
    videos = (videosResult.results || []).map((video: any) => {
      const media = allMedia.find((m: any) => m.id === video.thumbnail_media_id);
      return {
        ...video,
        r2_key: media ? media.r2_key : undefined
      };
    });
    
    socials = (socialsResult.results || []).map((soc: any) => {
      const media = allMedia.find((m: any) => m.id === soc.logo_media_id);
      return {
        ...soc,
        r2_key: media ? media.r2_key : undefined
      };
    });
    
    musicLinks = (musicLinksResult.results || []).map((link: any) => {
      const media = allMedia.find((m: any) => m.id === link.logo_media_id);
      return {
        ...link,
        r2_key: media ? media.r2_key : undefined
      };
    });
    settings = settingsRow || {
      merch_url_en: "", merch_url_zh_tw: "", merch_url_zh_cn: "", merch_is_active: 0,
      bonus_title_en: "", bonus_title_zh_tw: "", bonus_title_zh_cn: "",
      bonus_text_en: "", bonus_text_zh_tw: "", bonus_text_zh_cn: "",
      bonus_media_id: null, bonus_is_active: 0
    };
    mediaList = mediaResult.results || [];
  } catch (e: any) {
    error = e.message;
  }
} else {
  error = "Database is not available.";
}

function getMediaUrl(id: number | null) {
  if (!id) return "";
  const found = mediaList.find((m) => m.id === id);
  return found ? `${baseMediaUrl}/${found.r2_key}` : "";
}
---

<AdminLayout title="Content Manager">
  <div class="content-header">
    <h1>Content Manager</h1>
    <p class="admin-muted">Manage all trilingual marketing copy, tour dates, album listings, and media integrations.</p>
  </div>

  {error && <div class="admin-alert admin-alert-error">{error}</div>}

  <!-- Tab Buttons -->
  <div class="tab-buttons">
    <button class="tab-btn active" data-tab="news">News Block</button>
    <button class="tab-btn" data-tab="tours">Tour Dates</button>
    <button class="tab-btn" data-tab="albums">Music & Albums</button>
    <button class="tab-btn" data-tab="videos">Moment</button>
    <button class="tab-btn" data-tab="socials-merch">Socials & Merch</button>
    <button class="tab-btn" data-tab="bonus">Bonus page</button>
  </div>

  <!-- Tab Contents -->
  <div class="tab-contents">
    
    <!-- NEWS TAB -->
    <div class="tab-pane active" id="tab-news">
      <form id="news-form" class="admin-form card-form">
        <h2>News Banner Settings</h2>
        
        <div class="form-grid">
          <div class="form-group">
            <label>Title (English)</label>
            <input type="text" name="title_en" value={news.title_en} required />
          </div>
          <div class="form-group">
            <label>Title (Traditional Chinese)</label>
            <input type="text" name="title_zh_tw" value={news.title_zh_tw} required />
          </div>
          <div class="form-group">
            <label>Title (Simplified Chinese)</label>
            <input type="text" name="title_zh_cn" value={news.title_zh_cn} required />
          </div>
        </div>

        <div class="form-grid">
          <div class="form-group">
            <label>Body Text (English)</label>
            <textarea name="body_en" rows="3" required>{news.body_en}</textarea>
          </div>
          <div class="form-group">
            <label>Body Text (Traditional Chinese)</label>
            <textarea name="body_zh_tw" rows="3" required>{news.body_zh_tw}</textarea>
          </div>
          <div class="form-group">
            <label>Body Text (Simplified Chinese)</label>
            <textarea name="body_zh_cn" rows="3" required>{news.body_zh_cn}</textarea>
          </div>
        </div>

        <div class="form-grid">
          <!-- Background Image Picker -->
          <div class="form-group">
            <label>Background Image</label>
            <div class="media-picker-control" data-field="background_media_id">
              <input type="hidden" name="background_media_id" value={news.background_media_id || ""} />
              <div class="picker-preview">
                {news.background_media_id ? (
                  <img src={getMediaUrl(news.background_media_id)} alt="Selected Background" />
                ) : (
                  <span class="no-img">No Image Selected</span>
                )}
              </div>
              <div class="picker-actions">
                <button type="button" class="btn-select-media">Select Image</button>
                <button type="button" class="btn-clear-media" style={news.background_media_id ? "" : "display:none;"}>Clear</button>
              </div>
            </div>
          </div>

          <!-- Countdown Picker -->
          <div class="form-group">
            <label>Countdown Target (UTC Date/Time)</label>
            <input 
              type="datetime-local" 
              name="countdown_at_utc" 
              value={news.countdown_at_utc ? news.countdown_at_utc.slice(0, 16) : ""} 
            />
            <span class="field-hint">Leave blank to disable the countdown clock. Use UTC time.</span>
          </div>

          <!-- Status toggle -->
          <div class="form-group row-group">
            <input type="checkbox" id="news-active" name="is_active" checked={news.is_active === 1} />
            <label for="news-active">Display News block on website</label>
          </div>
        </div>

        <button type="submit" class="btn-submit">Save News settings</button>
      </form>
    </div>

    <!-- TOURS TAB -->
    <div class="tab-pane" id="tab-tours">
      <div class="actions-bar">
        <h2>Tour Schedule</h2>
        <button class="btn-primary" id="btn-add-tour">Add Tour Date</button>
      </div>

      <!-- Tour Dates Table -->
      <table class="admin-table">
        <thead>
          <tr>
            <th>Date & Time</th>
            <th>Location (EN / 繁 / 简)</th>
            <th>Description (TW)</th>
            <th>Links</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {tours.length === 0 ? (
            <tr>
              <td colspan="6" class="admin-muted" style="text-align: center; padding: 24px;">No tour dates scheduled.</td>
            </tr>
          ) : (
            tours.map((t) => (
              <tr data-tour-id={t.id}>
                <td>
                  <strong>{t.local_date}</strong>
                  <span class="time-meta">{t.local_time} ({t.timezone})</span>
                </td>
                <td>
                  <div>EN: {t.location_en}</div>
                  <div>繁: {t.location_zh_tw}</div>
                  <div>简: {t.location_zh_cn}</div>
                </td>
                <td class="admin-muted" style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                  {t.description_zh_tw}
                </td>
                <td>
                  <button class="btn-manage-links" data-id={t.id} data-location={t.location_zh_tw}>
                    Ticket Links
                  </button>
                </td>
                <td>
                  <span class:list={["badge", t.is_active === 1 ? "badge-active" : "badge-inactive"]}>
                    {t.is_active === 1 ? "Active" : "Hidden"}
                  </span>
                </td>
                <td>
                  <button class="btn-edit-tour" data-tour={JSON.stringify(t)}>Edit</button>
                  <button class="btn-delete-tour delete-btn" data-id={t.id}>Delete</button>
                </td>
              </tr>
            ))
          )}
        </tbody>
      </table>
    </div>

    <!-- ALBUMS TAB -->
    <div class="tab-pane" id="tab-albums">
      <div class="card-form">
        <div class="actions-bar">
          <h2>Music Streaming Platforms</h2>
          <button type="button" class="btn-primary" id="btn-add-music">Add Music Platform</button>
        </div>
        <p class="admin-muted">Add streaming platforms (e.g. Spotify, Apple Music) displayed on the music page. Select logo PNGs/SVGs and input URLs.</p>

        <table class="admin-table">
          <thead>
            <tr>
              <th>Logo</th>
              <th>Platform Name</th>
              <th>Target URL</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {musicLinks.map((link) => (
              <tr data-music-id={link.id}>
                <td>
                  <div class="picker-preview select-sm" style="width: 40px; height: 40px; border: 1px solid var(--admin-line); background: var(--admin-bg); display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 4px;">
                    <img src={getMediaUrl(link.logo_media_id)} alt={link.name} style="max-width: 100%; max-height: 100%; object-fit: contain;" />
                  </div>
                </td>
                <td><strong>{link.name}</strong></td>
                <td><a href={link.url} target="_blank" class="admin-muted" style="text-decoration: underline; color: var(--text-muted);">Link</a></td>
                <td>
                  <span class:list={["badge", link.is_active === 1 ? "badge-active" : "badge-inactive"]}>
                    {link.is_active === 1 ? "Active" : "Hidden"}
                  </span>
                </td>
                <td>
                  <button class="btn-edit-music" data-music={JSON.stringify(link)}>Edit</button>
                  <button class="btn-delete-music delete-btn" data-id={link.id}>Delete</button>
                </td>
              </tr>
            ))}
            {musicLinks.length === 0 && (
              <tr>
                <td colspan="5" class="admin-muted" style="text-align: center; padding: 24px;">No music platform links configured.</td>
              </tr>
            )}
          </tbody>
        </table>
      </div>

      <div class="card-form" style="margin-top: 2rem;">
        <div class="actions-bar">
          <h2>Album Covers (Mosaic Grid)</h2>
          <button type="button" class="btn-primary" id="btn-add-album">Add Cover</button>
        </div>
        <p class="admin-muted">Add album covers here. Order is set by sorting position. Albums link to the public Music page.</p>

        <table class="admin-table">
          <thead>
            <tr>
              <th>Cover</th>
              <th>Album Title</th>
              <th>Release Date</th>
              <th>Platform Links</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {albums.map((album) => (
              <tr data-album-id={album.id}>
                <td>
                  <div class="picker-preview select-sm" style="width: 50px; height: 50px; border: 1px solid var(--admin-line); background: var(--admin-bg); display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 4px;">
                    <img src={getMediaUrl(album.image_media_id)} alt={album.title} style="max-width: 100%; max-height: 100%; object-fit: contain;" />
                  </div>
                </td>
                <td><strong>{album.title}</strong></td>
                <td><code style="font-size: 0.9rem; background: rgba(0, 0, 0, 0.05); padding: 2px 6px; border-radius: 4px; border: 1px solid var(--admin-line);">{album.production_date || album.productionDate}</code></td>
                <td>
                  <div style="font-size: 0.85rem; color: var(--admin-text-muted); display: flex; flex-direction: column; gap: 4px;">
                    {album.links && album.links.length > 0 ? (
                      album.links.map((l: any) => {
                        const plat = musicLinks.find(p => p.id === l.platform_id || p.id === l.platformId);
                        return <div><strong>{plat ? plat.name : "Platform"}:</strong> <a href={l.url} target="_blank" class="admin-muted" style="text-decoration: underline; color: var(--text-muted);">Link</a></div>;
                      })
                    ) : (
                      <span class="admin-muted">No custom links</span>
                    )}
                  </div>
                </td>
                <td>
                  <span class:list={["badge", album.is_active === 1 ? "badge-active" : "badge-inactive"]}>
                    {album.is_active === 1 ? "Active" : "Hidden"}
                  </span>
                </td>
                <td>
                  <button class="btn-edit-album" data-album={JSON.stringify(album)}>Edit</button>
                  <button class="btn-delete-album delete-btn" data-id={album.id}>Delete</button>
                </td>
              </tr>
            ))}
            {albums.length === 0 && (
              <tr>
                <td colspan="5" class="admin-muted" style="text-align: center; padding: 24px;">No album covers configured.</td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </div>

    <!-- VIDEOS TAB (MOMENT) -->
    <div class="tab-pane" id="tab-videos">
      <div class="card-form">
        <div class="actions-bar">
          <h2>Carousel Playable Moments</h2>
          <button type="button" class="btn-primary" id="btn-add-video">Add Moment</button>
        </div>
        <p class="admin-muted">Set up playable moments. Select a video from your uploaded video assets and choose an image for its thumbnail cover.</p>

        <table class="admin-table">
          <thead>
            <tr>
              <th>Thumbnail</th>
              <th>Video Title</th>
              <th>Video File</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {videos.map((vid) => (
              <tr data-video-id={vid.id}>
                <td>
                  <div class="picker-preview select-sm" style="width: 50px; height: 50px; border: 1px solid var(--admin-line); background: var(--admin-bg); display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 4px;">
                    {vid.thumbnail_media_id ? (
                      <img src={getMediaUrl(vid.thumbnail_media_id)} alt={vid.title} style="max-width: 100%; max-height: 100%; object-fit: contain;" />
                    ) : (
                      <span class="no-img">No Image</span>
                    )}
                  </div>
                </td>
                <td><strong>{vid.title}</strong></td>
                <td><span class="admin-muted" style="font-size: 0.85rem; word-break: break-all;">{vid.url_en ? vid.url_en.split("/").pop() : "No video file"}</span></td>
                <td>
                  <span class:list={["badge", vid.is_active === 1 ? "badge-active" : "badge-inactive"]}>
                    {vid.is_active === 1 ? "Active" : "Hidden"}
                  </span>
                </td>
                <td>
                  <button class="btn-edit-video" data-video={JSON.stringify(vid)}>Edit</button>
                  <button class="btn-delete-video delete-btn" data-id={vid.id}>Delete</button>
                </td>
              </tr>
            ))}
            {videos.length === 0 && (
              <tr>
                <td colspan="5" class="admin-muted" style="text-align: center; padding: 24px;">No moments configured.</td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </div>

    <!-- SOCIALS & MERCH TAB -->
    <div class="tab-pane" id="tab-socials-merch">
      <!-- Merch Form -->
      <form id="merch-form" class="admin-form card-form mb-4">
        <h2>Merchandising External Shop Settings</h2>
        <p class="admin-muted">Configure external shops (e.g. Shopee, Shopify) per language. If inactive, the public shop link redirects to "Coming soon".</p>
        
        <div class="form-grid">
          <div class="form-group">
            <label>Shop URL (English)</label>
            <input type="url" name="merch_url_en" value={settings.merch_url_en} placeholder="https://..." />
          </div>
          <div class="form-group">
            <label>Shop URL (Traditional Chinese)</label>
            <input type="url" name="merch_url_zh_tw" value={settings.merch_url_zh_tw} placeholder="https://..." />
          </div>
          <div class="form-group">
            <label>Shop URL (Simplified Chinese)</label>
            <input type="url" name="merch_url_zh_cn" value={settings.merch_url_zh_cn} placeholder="https://..." />
          </div>
        </div>

        <div class="form-group">
          <label style="margin-bottom: 6px; display: block;">Merchandising Status</label>
          <div class="switch-container">
            <label class="switch-toggle-label">
              <input type="checkbox" id="merch-active" name="merch_is_active" checked={settings.merch_is_active === 1} />
              <div class="switch-layout">
                <span class="switch-label text-disabled">Disabled</span>
                <div class="switch-slider-track">
                  <span class="switch-slider-thumb"></span>
                </div>
                <span class="switch-label text-available">Available</span>
              </div>
            </label>
          </div>
        </div>

        <button type="submit" class="btn-submit">Save Merch Settings</button>
      </form>

      <!-- Socials Form -->
      <div class="card-form">
        <div class="actions-bar">
          <h2>Footer Social Platforms</h2>
          <button type="button" class="btn-primary" id="btn-add-social">Add Platform</button>
        </div>
        <p class="admin-muted">Add social links displayed in the footer. Upload clean, colored or monochrome logo PNG/SVGs to R2 and reference them below.</p>

        <table class="admin-table">
          <thead>
            <tr>
              <th>Logo</th>
              <th>Platform Name</th>
              <th>Target URL</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {socials.map((soc) => (
              <tr data-social-id={soc.id}>
                <td>
                  <div class="picker-preview select-sm" style="width: 40px; height: 40px; border: 1px solid var(--admin-line); background: var(--admin-bg); display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 4px;">
                    <img src={getMediaUrl(soc.logo_media_id)} alt={soc.name} style="max-width: 100%; max-height: 100%; object-fit: contain;" />
                  </div>
                </td>
                <td><strong>{soc.name}</strong></td>
                <td><a href={soc.url} target="_blank" class="admin-muted" style="text-decoration: underline; color: var(--text-muted);">Link</a></td>
                <td>
                  <span class:list={["badge", soc.is_active === 1 ? "badge-active" : "badge-inactive"]}>
                    {soc.is_active === 1 ? "Active" : "Hidden"}
                  </span>
                </td>
                <td>
                  <button class="btn-edit-social" data-social={JSON.stringify(soc)}>Edit</button>
                  <button class="btn-delete-social delete-btn" data-id={soc.id}>Delete</button>
                </td>
              </tr>
            ))}
            {socials.length === 0 && (
              <tr>
                <td colspan="5" class="admin-muted" style="text-align: center; padding: 24px;">No social platforms configured.</td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </div>

    <!-- BONUS TAB -->
    <div class="tab-pane" id="tab-bonus">
      <form id="bonus-form" class="admin-form card-form">
        <h2>Bonus Page Settings</h2>
        <p class="admin-muted">Manage the Title, Text, and Image displayed when clicking the "Extra bonus" button.</p>

        <div class="form-grid">
          <div class="form-group">
            <label>Title (English)</label>
            <input type="text" name="bonus_title_en" value={settings.bonus_title_en || ""} required />
          </div>
          <div class="form-group">
            <label>Title (Traditional Chinese)</label>
            <input type="text" name="bonus_title_zh_tw" value={settings.bonus_title_zh_tw || ""} required />
          </div>
          <div class="form-group">
            <label>Title (Simplified Chinese)</label>
            <input type="text" name="bonus_title_zh_cn" value={settings.bonus_title_zh_cn || ""} required />
          </div>
        </div>

        <div class="form-grid">
          <div class="form-group">
            <label>Text (English)</label>
            <textarea name="bonus_text_en" rows="3" required>{settings.bonus_text_en || ""}</textarea>
          </div>
          <div class="form-group">
            <label>Text (Traditional Chinese)</label>
            <textarea name="bonus_text_zh_tw" rows="3" required>{settings.bonus_text_zh_tw || ""}</textarea>
          </div>
          <div class="form-group">
            <label>Text (Simplified Chinese)</label>
            <textarea name="bonus_text_zh_cn" rows="3" required>{settings.bonus_text_zh_cn || ""}</textarea>
          </div>
        </div>

        <div class="form-grid">
          <div class="form-group">
            <label>Bonus Image</label>
            <div class="media-picker-control" data-field="bonus_media_id">
              <input type="hidden" name="bonus_media_id" value={settings.bonus_media_id || ""} />
              <div class="picker-preview">
                {settings.bonus_media_id ? (
                  <img src={getMediaUrl(settings.bonus_media_id)} alt="Selected Bonus Image" />
                ) : (
                  <span class="no-img">No Image Selected</span>
                )}
              </div>
              <div class="picker-actions">
                <button type="button" class="btn-select-media">Select Image</button>
                <button type="button" class="btn-clear-media" style={settings.bonus_media_id ? "" : "display:none;"}>Clear</button>
              </div>
            </div>
          </div>
        </div>

        <div class="form-grid">
          <div class="form-group checkbox-cell" style="margin-top: 0; align-self: start;">
            <div class="row-group">
              <input type="checkbox" id="bonus-active" name="bonus_is_active" checked={settings.bonus_is_active === 1} />
              <label for="bonus-active" style="text-transform: none; font-size: 0.95rem; font-weight: normal; cursor: pointer;">Bonus Page Active (show loading bar and button)</label>
            </div>
          </div>
        </div>

        <button type="submit" class="btn-submit">Save Bonus Settings</button>
      </form>
    </div>

  </div>

  <!-- MEDIA PICKER MODAL (HIDDEN BY DEFAULT) -->
  <div class="admin-modal" id="media-picker-modal">
    <div class="modal-content">
      <header class="modal-header">
        <h3>Select Media Asset</h3>
        <button type="button" class="btn-close-modal" id="btn-close-media-modal">&times;</button>
      </header>
      <div class="modal-body">
        <div class="media-search-bar">
          <input type="text" id="media-search-input" placeholder="Search files by name..." />
        </div>
        <div class="modal-media-grid" id="modal-media-grid">
          {mediaList.map((m) => (
            <div class="modal-media-item" data-id={m.id} data-url={`${baseMediaUrl}/${m.r2_key}`} data-name={m.file_name} data-media-type={m.content_type.startsWith("video/") ? "video" : "image"}>
              {m.content_type.startsWith("video/") ? (
                <div class="video-placeholder-preview" style="aspect-ratio: 4/3; background: #111; display: grid; place-items: center; position: relative; width: 100%; height: 100%; min-height: 80px;">
                  <span style="font-size: 1.5rem;">📹</span>
                </div>
              ) : (
                <img src={`${baseMediaUrl}/${m.r2_key}`} alt={m.alt_text || m.file_name} />
              )}
              <span class="modal-item-name" title={m.file_name}>{m.file_name}</span>
            </div>
          ))}
          {mediaList.length === 0 && <div class="admin-muted" style="grid-column: 1/-1; text-align: center; padding: 24px;">No media assets available. Go to the Media Library to upload files first.</div>}
