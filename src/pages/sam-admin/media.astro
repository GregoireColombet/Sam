---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { formatBytes } from "@/lib/utils";

export const prerender = false;

const env = Astro.locals.runtime?.env;
const db = env?.DB;
const baseMediaUrl = (env?.PUBLIC_MEDIA_BASE_URL || "/media").replace(/\/$/, "");

let mediaList: any[] = [];
let error = "";

if (db) {
  try {
    const result = await db.prepare(`select * from media_assets order by created_at desc`).all();
    mediaList = result.results || [];
  } catch (e: any) {
    error = e.message;
  }
} else {
  error = "Database binding is not available.";
}

const pictures = mediaList.filter((asset) => asset.content_type.startsWith("image/"));
const videos = mediaList.filter((asset) => asset.content_type.startsWith("video/"));
---

<AdminLayout title="Media Library">
  <div class="media-header">
    <div>
      <h1>Media Library</h1>
      <p class="admin-muted">Upload and manage image assets and video assets hosted on Cloudflare.</p>
    </div>
    <label class="upload-btn" for="media-file-input">
      Upload File
    </label>
    <input type="file" id="media-file-input" accept="image/png, image/jpeg, image/webp" style="display: none;" />
  </div>

  {error && <div class="admin-alert admin-alert-error">{error}</div>}

  <!-- Tab Buttons -->
  <div class="tab-buttons">
    <button class="tab-btn active" data-tab="pictures">Pictures</button>
    <button class="tab-btn" data-tab="videos">Videos</button>
  </div>

  <div class="tab-contents">
    <!-- PICTURES TAB -->
    <div class="tab-pane active" id="tab-pictures">
      <div class="drop-zone" id="media-drop-zone-pictures" data-type="pictures">
        <span class="drop-zone-text">Drag and drop pictures here or click "Upload File" (PNG, JPG, WEBP only)</span>
      </div>

      <div class="media-grid" id="pictures-grid">
        {pictures.length === 0 ? (
          <div class="empty-media" id="empty-pictures-msg">No pictures uploaded yet.</div>
        ) : (
          pictures.map((asset) => (
            <div class="media-card" data-asset-id={asset.id}>
              <div class="media-preview">
                <img src={`${baseMediaUrl}/${asset.r2_key}`} alt={asset.alt_text || asset.file_name} />
              </div>
              <div class="media-details">
                <strong class="media-name" title={asset.file_name}>{asset.file_name}</strong>
                <span class="media-meta">{formatBytes(asset.size_bytes)} · {asset.content_type.split("/")[1].toUpperCase()}</span>
                <input type="text" class="media-url-input" readonly value={`${baseMediaUrl}/${asset.r2_key}`} title="Click to copy URL" />
                <button class="delete-btn" data-id={asset.id}>Delete</button>
              </div>
            </div>
          ))
        )}
      </div>
    </div>

    <!-- VIDEOS TAB -->
    <div class="tab-pane" id="tab-videos">
      <div class="drop-zone" id="media-drop-zone-videos" data-type="videos">
        <span class="drop-zone-text">Drag and drop videos here or click "Upload File" (MP4, WEBM, OGG, MOV only)</span>
      </div>

      <div class="media-grid" id="videos-grid">
        {videos.length === 0 ? (
          <div class="empty-media" id="empty-videos-msg">No videos uploaded yet.</div>
        ) : (
          videos.map((asset) => (
            <div class="media-card" data-asset-id={asset.id}>
              <div class="media-preview">
                <video src={`${baseMediaUrl}/${asset.r2_key}`} muted preload="metadata" controls style="max-width: 100%; max-height: 100%; object-fit: contain;"></video>
              </div>
              <div class="media-details">
                <strong class="media-name" title={asset.file_name}>{asset.file_name}</strong>
                <span class="media-meta">{formatBytes(asset.size_bytes)} · {asset.content_type.split("/")[1].toUpperCase()}</span>
                <input type="text" class="media-url-input" readonly value={`${baseMediaUrl}/${asset.r2_key}`} title="Click to copy URL" />
                <button class="delete-btn" data-id={asset.id}>Delete</button>
              </div>
            </div>
          ))
        )}
      </div>
    </div>
  </div>

  <script src="./media.client.ts"></script>
</AdminLayout>

<style is:global>
  .media-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 24px;
  }

  .upload-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #7d5b2f;
    color: #fff;
    font-weight: 700;
    min-height: 40px;
    padding: 0 20px;
    cursor: pointer;
    border-radius: 4px;
    transition: background 180ms ease;
  }

  .upload-btn:hover {
    background: #966f3e;
  }

  .admin-alert {
    padding: 12px 16px;
    border-left: 3px solid #e55353;
    background: rgba(229, 83, 83, 0.08);
    color: #d64a4a;
    margin-bottom: 24px;
  }

  .tab-buttons {
    display: flex;
    gap: 8px;
    border-bottom: 1px solid var(--admin-line);
    margin-bottom: 24px;
  }

  .tab-btn {
    min-height: 40px;
    padding: 0 16px;
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: var(--admin-muted);
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 180ms ease;
  }

  .tab-btn:hover {
    color: var(--admin-text);
  }

  .tab-btn.active {
    color: #7d5b2f;
    border-color: #7d5b2f;
  }

  .tab-pane {
    display: none;
  }

  .tab-pane.active {
    display: block;
  }

  .drop-zone {
    border: 2px dashed var(--admin-line);
    background: var(--admin-panel);
    padding: 40px 20px;
    text-align: center;
    color: var(--admin-muted);
    font-weight: 500;
    margin-bottom: 32px;
    transition:
      border-color 180ms ease,
      background-color 180ms ease;
  }

  .drop-zone.highlight {
    border-color: #7d5b2f;
    background: rgba(125, 91, 47, 0.05);
  }

  .media-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 20px;
  }

  .empty-media {
    grid-column: 1 / -1;
    text-align: center;
    padding: 48px;
    color: var(--admin-muted);
    border: 1px solid var(--admin-line);
    background: var(--admin-panel);
  }

  .media-card {
    border: 1px solid var(--admin-line);
    background: var(--admin-panel);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .media-preview {
    aspect-ratio: 4 / 3;
    background: #000;
    border-bottom: 1px solid var(--admin-line);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
  }

  .media-preview img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .media-details {
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .media-name {
    font-size: 0.9rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .media-meta {
    font-size: 0.75rem;
    color: var(--admin-muted);
  }

  .media-url-input {
    width: 100%;
    font-size: 0.75rem;
    padding: 6px;
    background: var(--admin-bg);
    border: 1px solid var(--admin-line);
    color: var(--admin-muted);
    cursor: pointer;
    text-align: center;
  }

  .media-url-input:hover {
    color: var(--admin-text);
  }

  .delete-btn {
    border: 1px solid rgba(229, 83, 83, 0.4);
    background: transparent;
    color: #e55353;
    padding: 6px 12px;
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
    margin-top: 4px;
    transition:
      background 180ms ease,
      color 180ms ease;
  }

  .delete-btn:hover {
    background: #e55353;
    color: #fff;
  }
</style>
