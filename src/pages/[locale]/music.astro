---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteNav from "@/components/SiteNav.astro";
import Footer from "@/components/Footer.astro";
import PlatformLinks from "@/components/PlatformLinks.astro";
import { getLandingContent, getMerchUrl, getMusicLinks } from "@/lib/db";
import { isLocale, labels, type Locale } from "@/lib/i18n";

export const prerender = false;

const requestedLocale = Astro.params.locale;
if (!isLocale(requestedLocale)) {
  return Astro.redirect("/zh-TW/music");
}

const locale: Locale = requestedLocale;
const env = Astro.locals.runtime?.env;
const [links, landing, merchUrl] = await Promise.all([
  getMusicLinks(env),
  getLandingContent(env),
  getMerchUrl(env, locale)
]);
const t = labels[locale];
---

<BaseLayout locale={locale} title={`Sam Lee | ${t.streaming}`}>
  <SiteNav locale={locale} merchUrl={merchUrl} />
  <main class="page-main">
    <section class="section">
      <div class="container">
        <h1 class="section-title">{t.streaming}</h1>
        {links.length > 0 ? <PlatformLinks links={links} /> : <div class="empty-state">{t.musicComingSoon}</div>}
      </div>
    </section>
  </main>
  <Footer locale={locale} socialLinks={landing.socialLinks} />
</BaseLayout>

<style>
  .page-main {
    padding-top: 96px;
    min-height: 74vh;
    background: transparent;
    color: var(--ice-white);
  }

  .page-main :global(.platform-link) {
    border-color: var(--line);
    background: var(--night-graphite);
    color: var(--ice-white);
  }

  .page-main :global(.platform-link:hover) {
    background: var(--night-graphite);
    color: var(--ice-white);
    border-color: var(--coral-red);
    box-shadow: 0 4px 12px rgba(255, 116, 125, 0.35);
  }

  .page-main :global(.empty-state) {
    border-color: var(--line);
    color: var(--text-muted);
  }
</style>
