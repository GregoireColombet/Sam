---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteNav from "@/components/SiteNav.astro";
import Footer from "@/components/Footer.astro";
import { getLandingContent, getMerchUrl } from "@/lib/db";
import { isLocale, type Locale } from "@/lib/i18n";

export const prerender = false;

const requestedLocale = Astro.params.locale;
if (!isLocale(requestedLocale)) {
  return Astro.redirect("/zh-TW/past");
}

const locale: Locale = requestedLocale;
const env = Astro.locals.runtime?.env;
const [landing, merchUrl] = await Promise.all([
  getLandingContent(env),
  getMerchUrl(env, locale)
]);

const pageTitles = {
  en: "Past",
  "zh-TW": "過去",
  "zh-CN": "过去"
};

const textContent = {
  en: "Sam Lee's musical journey began with a passion that defined a generation. From his early debut to performing on stages worldwide, the past represents the foundation of his deep connection with fans through unforgettable classic love songs and albums. Over the years, his dedication to the art of singing and his distinct vocal tone has built a legacy that continues to resonate with listeners across all walks of life.",
  "zh-TW": "李聖傑的音樂旅程始於定義了一個世代的熱情。從早期的出道到在世界各地的舞台上演出，過去代表了他與樂迷之間深厚連結的基石，帶來無數令人難忘的經典情情歌與專輯。多年來，他對歌唱藝術的專注與獨特嗓音，鑄就了這段持續在所有聽眾心中共鳴的經典傳奇。",
  "zh-CN": "李圣杰的音乐旅程始于定义了一个世代的热情。从早期的出道到在世界各地的舞台上演出，过去代表了他与乐迷之间深厚联结的基石，带来无数令人难忘的经典情歌与专辑。多年来，他对歌唱艺术的专注与独特嗓音，铸就了这段持续在所有听众心中共鸣的经典传奇。"
};

const title = pageTitles[locale];
const paragraphText = textContent[locale];
---

<BaseLayout locale={locale} title={`Sam Lee | ${title}`}>
  <SiteNav locale={locale} merchUrl={merchUrl} />
  <main class="page-main">
    <section class="section hero-section">
      <div class="container text-center">
        <h1 class="page-title">{title}</h1>
        <div class="divider"></div>
      </div>
    </section>

    <section class="content-section">
      <div class="container">
        <div class="image-wrapper">
          <img src="/assets/about/about_debut.jpg" alt="Sam Lee Past Journey" class="past-image" />
        </div>
        <div class="text-wrapper">
          <p class="paragraph">{paragraphText}</p>
        </div>
      </div>
    </section>
  </main>
  <Footer locale={locale} socialLinks={landing.socialLinks} />
</BaseLayout>

<style>
  .page-main {
    padding-top: 96px;
    min-height: 80vh;
    background: transparent;
    color: var(--ice-white);
  }

  .text-center {
    text-align: center;
  }

  .hero-section {
    padding-bottom: 24px;
    background: transparent;
  }

  .page-title {
    margin: 0;
    font-size: clamp(2.5rem, 6vw, 4.8rem);
    font-weight: normal;
    letter-spacing: -0.02em;
    color: var(--aqua-glow);
    text-transform: uppercase;
    text-shadow: none;
  }

  .divider {
    width: 40%;
    height: 4px;
    background: var(--aqua-glow);
    margin: 24px auto 0;
    border-radius: 2px;
    box-shadow: 0 -4px 10px var(--aqua-glow);
  }

  .content-section {
    padding: 24px 0 80px;
  }

  .image-wrapper {
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    border: 2px solid var(--line);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    margin-bottom: 40px;
  }

  .past-image {
    width: 100%;
    height: auto;
    display: block;
    filter: grayscale(100%);
    transition: transform 0.6s ease;
  }

  .image-wrapper:hover .past-image {
    transform: scale(1.02);
  }

  .text-wrapper {
    max-width: 800px;
    margin: 0 auto;
  }

  .paragraph {
    font-size: 1.15rem;
    line-height: 1.8;
    margin: 0;
    opacity: 0.9;
    text-align: justify;
    color: var(--ice-white);
  }
</style>
