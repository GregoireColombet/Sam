---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteNav from "@/components/SiteNav.astro";
import Footer from "@/components/Footer.astro";
import { getLandingContent, getMerchUrl, getBonusSettings } from "@/lib/db";
import { isLocale, type Locale, getLocalized } from "@/lib/i18n";

export const prerender = false;

const requestedLocale = Astro.params.locale;
if (!isLocale(requestedLocale)) {
  return Astro.redirect("/zh-TW/about");
}

const locale: Locale = requestedLocale;
const env = Astro.locals.runtime?.env;
const [landing, merchUrl, bonusSettings] = await Promise.all([
  getLandingContent(env),
  getMerchUrl(env, locale),
  getBonusSettings(env)
]);

const pastTitles = {
  en: "Past",
  "zh-TW": "過去",
  "zh-CN": "过去"
};

const presentTitles = {
  en: "Present",
  "zh-TW": "現在",
  "zh-CN": "现在"
};

const futureTitles = {
  en: "Future",
  "zh-TW": "未來",
  "zh-CN": "未来"
};

const pastSubtitles = {
  en: "Some voices are made to outlast time.",
  "zh-TW": "有些聲音，會被時間留下來。",
  "zh-CN": "有些声音，会被时间留下来。"
};

const presentSubtitles = {
  en: "A classic never stands still. It keeps evolving.",
  "zh-TW": "經典不是停留，\n而是繼續發生。",
  "zh-CN": "经典不是停留，\n而是继续发生。"
};

const futureSubtitles = {
  en: "The next chapter has no boundaries.",
  "zh-TW": "下一章，還沒有被定義。",
  "zh-CN": "下一章，还没有被定义。"
};

const pastText = {
  en: `Before he became Sam Lee, there was a long journey of searching.

From singing competitions and pub gigs to live stages, through waiting, setbacks, and countless fresh starts, he never stopped singing.
And in those unseen days,he slowly found a voice that truly belonged to him.

Then Devotion Love was heard by the world.
After that came Let Go, The Song About You, and Passing By.
Through his voice,emotions of love, regret, departure, and letting go began to find their way into people’s lives.

Years later, we may no longer remember exactly what happened back then, and yet, when a certain melody begins to play, we are reminded of who we once were.

Time turns songs into classics, but what truly remains is memory.`,
  "zh-TW": `在成為 Sam Lee 之前，是一段漫長的尋找。

從歌唱比賽、Pub 駐唱到 Live 舞台，經歷等待、低潮與一次次重新開始，他沒有停止唱歌，也在那些不被看見的日子裡，慢慢找到屬於自己的聲音。

直到《癡心絕對》被世界聽見，接著《手放開》，《關於妳的歌》，《擦肩而過》，那些關於愛、遺憾、離開與放手的情緒，開始透過他的聲音，走進不同人的生命。

多年以後，也許我們忘記了當時發生過什麼，卻仍會在某段旋律響起時，想起曾經的自己。
時間讓歌曲成為經典，而真正留下來的，是記憶。`,
  "zh-CN": `在成为 Sam Lee 之前，是一段漫长的寻找。
从歌唱比赛、Pub 驻唱到 Live 舞台，经历等待、低潮与一次次重新开始，他没有停止唱歌，也在那些不被看见的日子里，慢慢找到属于自己的声音。
直到《痴心绝对》被世界听见，接着《手放开》、《关于妳的歌》、《擦肩而过》，那些关于爱、遗憾、离开与放手的情绪，开始透过他的声音，走进不同人的生命。

多年以后，也许我们忘记了当时发生过什么，却仍会在某段旋律响起时，想起曾经的自己。
时间让歌曲成为经典，而真正留下来的，是记忆。`
};

const presentText = {
  en: `Moving through different roles as a singer, songwriter, and producer, Sam Lee began to understand music from a broader perspective.

Building his own music brand meant moving beyond simply singing a song toward creating a more complete musical world—one shaped by sound, creativity, and life, and by the ways music can create a genuine connection between people.

Time has changed the way we listen to music, just as life has changed the way we understand emotion. Today, Sam Lee no longer needs to repeat who he once was.

The familiar voice is still there, but after years of experience and reflection, it now carries a different kind of weight.

He still sings about emotion.
But today, rather than trying to answer what love is, he cares more about whether a song can stay with someone and accompany them through a chapter of their life.`,
  "zh-TW": `走過歌手、創作者與製作人的不同角色，Sam Lee 開始用更寬廣的方式理解音樂。

成立自己的音樂品牌，意味著從演唱一首歌，走向創造一個更完整的音樂世界——
關於聲音、創作、生活，也關於音樂如何與人產生真正的連結。

時間改變了聆聽音樂的方式，人生也改變了理解情感的角度。

今天的 Sam Lee，不需要重複過去的自己。

熟悉的聲音依然存在，只是經過時間與生命的沉澱之後，有了不同的重量。他依然唱情感，
只是現在，比起回答愛是什麼，更在意一首歌能不能陪一個人，走過生命中的某一段路。`,
  "zh-CN": `走过歌手、创作者与制作人的不同角色，Sam Lee 开始用更宽广的方式理解音乐。

成立自己的音乐品牌，意味着从演唱一首歌，走向创造一个更完整的音乐世界——
关于声音、创作、生活，也关于音乐如何与人产生真正的联结。

时间改变了聆听音乐的方式，人生也改变了理解情感的角度。

今天的 Sam Lee，不需要重复过去的自己。

熟悉的声音依然存在，只是经过时间与生命的沉淀之后，有了不同的重量。他依然唱情感，
只是现在，比起回答爱是什么，更在意一首歌能不能陪一个人，走过生命中的某一段路。`
};

const futureText = {
  en: `Music can be a song.
It can also be an image, a space, a live performance, or an experience we have yet to imagine.

From the very beginning, Sam Lee has explored the possibilities of sound, gradually placing music within a broader, more international perspective.

The musical world he is building has never belonged to a single form.

The future is not about leaving the past behind.
It is about carrying forward the emotions that once found their way to us, and moving toward new mediums, new cultures, and the unknown.

Forms will change.
The world will change.
The way we experience music will change, too.

But one thing will always remain—
a voice, and the moment it reaches someone’s heart.`,
  "zh-TW": `音樂可以是一首歌，也可以是一段影像、一個空間、一次現場，
或是一種我們尚未想像過的體驗。

從一開始對聲音可能性的探索，到將音樂放進更大的國際視野，Sam Lee 所建立的音樂世界，本來就不只屬於一種形式。

未來不是離開過去，而是帶著那些曾經被聽見的情感，走向新的媒介、新的文化，以及更多未知。

形式會改變。
世界會改變。
我們聽音樂的方式，也會改變。

但有一件事始終不變——
一個聲音，抵達另一個人心裡的瞬間。`,
  "zh-CN": `音乐可以是一首歌，也可以是一段影像、一个空间、一次现场，
或是一种我们尚未想象过的体验。

从一开始对声音可能性的探索，到将音乐放进更大的国际视野，Sam Lee 所建立的音乐世界，本来就不只属于一种形式。

未来不是离开过去，而是带着那些曾经被听见的情感，
走向新的媒介、新的文化，以及更多未知。

形式会改变。
世界会改变。
我们听音乐的方式，也会改变。

但有一件事始终不变——
一个声音，抵达另一个人心里的瞬间。`
};


const bonusTitle = getLocalized(bonusSettings?.title, locale);
const bonusText = getLocalized(bonusSettings?.text, locale);
const bonusImageUrl = bonusSettings?.imageUrl || "";
---

<BaseLayout locale={locale} title={`Sam Lee | About`}>
  <SiteNav locale={locale} merchUrl={merchUrl} />
  {bonusTitle && (
    <div class="scroll-gauge-container">
      <div class="scroll-gauge-bar" id="scroll-gauge-bar"></div>
    </div>
  )}
  <main class="page-main">
    <div class="about-container">

      <!-- Past Section -->
      <section class="about-section direction-row">
        <div class="media-column">
          <div class="image-wrapper">
            <img src="/assets/about/about_debut.jpg" alt="Sam Lee Past Journey" class="past-image" />
          </div>
        </div>
        <div class="text-column">
          <h2 class="section-title">{pastTitles[locale]}</h2>
          <p class="section-subtitle">{pastSubtitles[locale]}</p>
          <div class="section-divider"></div>
          <p class="paragraph">{pastText[locale]}</p>
        </div>
      </section>

      <!-- Present Section -->
      <section class="about-section direction-row-reverse">
        <div class="media-column">
          <div class="image-wrapper">
            <img src="/assets/about/about_tennis.jpg" alt="Sam Lee Present Journey" class="present-image" />
          </div>
        </div>
        <div class="text-column">
          <h2 class="section-title">{presentTitles[locale]}</h2>
          <p class="section-subtitle">{presentSubtitles[locale]}</p>
          <div class="section-divider"></div>
          <p class="paragraph">{presentText[locale]}</p>
        </div>
      </section>

      <!-- Future Section -->
      <section class="about-section direction-row">
        <div class="media-column">
          <div class="image-wrapper">
            <img src="/assets/about/about_venture.jpg" alt="Sam Lee Future Journey" class="future-image" />
          </div>
        </div>
        <div class="text-column">
          <h2 class="section-title">{futureTitles[locale]}</h2>
          <p class="section-subtitle">{futureSubtitles[locale]}</p>
          <div class="section-divider"></div>
          <p class="paragraph">{futureText[locale]}</p>
        </div>
      </section>

      {bonusTitle && (
        <div class="bonus-button-container">
          <button id="bonus-btn" class="bonus-btn" style="display: none;">Extra bonus</button>
        </div>
      )}
    </div>

    {bonusTitle && (
      <div id="bonus-modal" class="bonus-modal">
        <div class="bonus-modal-content">
          <button id="bonus-modal-close" class="bonus-modal-close" aria-label="Close">&times;</button>
          {bonusImageUrl && <img src={bonusImageUrl} alt={bonusTitle} class="bonus-modal-image" />}
          <h2 class="bonus-modal-title">{bonusTitle}</h2>
          <div class="bonus-modal-divider"></div>
          <p class="bonus-modal-text">{bonusText}</p>
        </div>
      </div>
    )}
  </main>
  <Footer locale={locale} socialLinks={landing.socialLinks} />
</BaseLayout>

<script>
  const bonusBtn = document.getElementById("bonus-btn");
  const bonusModal = document.getElementById("bonus-modal");
  const bonusClose = document.getElementById("bonus-modal-close");
  const gaugeBar = document.getElementById("scroll-gauge-bar");

  let progress = 0;
  let timer: number | null = null;
  let lastScrollY = window.scrollY;

  function updateGauge(value: number) {
    progress = value;
    if (gaugeBar) {
      gaugeBar.style.width = `${progress}%`;
    }
  }

  function handleScroll() {
    const windowHeight = window.innerHeight;
    const scrollY = window.scrollY;
    const documentHeight = document.documentElement.scrollHeight;
    const maxScroll = documentHeight - windowHeight;

    const isAtBottom = maxScroll <= 0 || (windowHeight + scrollY) >= (documentHeight - 15);

    if (scrollY !== lastScrollY) {
      lastScrollY = scrollY;
      // Scroll position changed (page moved)
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
      if (bonusBtn) {
        bonusBtn.style.display = "none";
      }
      // Set progress based on scroll position (0% to 80%)
      const scrollPercent = maxScroll > 0 ? (scrollY / maxScroll) * 80 : 80;
      updateGauge(Math.max(0, Math.min(80, scrollPercent)));
    }

    if (isAtBottom) {
      // Start/continue the timer if not already running and not yet 100%
      if (!timer && progress < 100 && bonusModal && !bonusModal.classList.contains("open")) {
        if (progress < 80) {
          updateGauge(80);
        }
        timer = window.setInterval(() => {
          if (progress < 100) {
            updateGauge(Math.min(100, progress + 5));
            if (progress >= 100) {
              if (timer) {
                clearInterval(timer);
                timer = null;
              }
              if (bonusBtn) {
                bonusBtn.style.display = "inline-block";
                bonusBtn.style.animation = "fadeIn 0.5s ease forwards";
              }
            }
          }
        }, 1000); // 1 second fills 5%
      }
    } else {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }
  }

  window.addEventListener("scroll", handleScroll);
  // Initial check on load
  handleScroll();

  bonusBtn?.addEventListener("click", () => {
    if (bonusModal) {
      bonusModal.classList.add("open");
    }
  });

  bonusClose?.addEventListener("click", () => {
    if (bonusModal) {
      bonusModal.classList.remove("open");
    }
    if (bonusBtn) {
      bonusBtn.style.display = "none";
    }
    if (timer) {
      clearInterval(timer);
      timer = null;
    }
    updateGauge(80);
    // Restart the process immediately if still at bottom
    lastScrollY = window.scrollY;
    handleScroll();
  });
</script>

<style>
  .scroll-gauge-container {
    position: fixed;
    top: 72px;
    left: 0;
    width: 100%;
    height: 4px;
    background: rgba(255, 255, 255, 0.05);
    border-top: 2px solid var(--line);
    z-index: 100;
  }

  .scroll-gauge-bar {
    height: 100%;
    width: 0%;
    background: var(--coral-red, #FF747D);
    box-shadow: 0 3px 8px var(--coral-red, #FF747D);
    transition: width 0.1s ease-out;
  }

  .page-main {
    padding-top: 120px;
    min-height: 80vh;
    background: transparent;
    color: var(--ice-white);
  }

  .about-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 40px 24px 80px;
    display: flex;
    flex-direction: column;
    gap: 80px;
  }

  .about-section {
    display: flex;
    align-items: center;
    gap: 60px;
  }

  .direction-row {
    flex-direction: row;
  }

  .direction-row-reverse {
    flex-direction: row-reverse;
  }

  .media-column {
    flex: 0 0 40%;
    width: 40%;
  }

  .text-column {
    flex: 1;
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: normal;
    letter-spacing: -0.02em;
    color: var(--aqua-glow);
    text-transform: uppercase;
    margin: 0 0 16px;
  }

  .section-subtitle {
    font-size: clamp(1.2rem, 2.5vw, 1.8rem);
    font-weight: normal;
    color: var(--ice-white);
    opacity: 0.95;
    margin: 0 0 16px;
    letter-spacing: -0.01em;
    line-height: 1.4;
  }

  .section-divider {
    width: 80px;
    height: 4px;
    background: var(--aqua-glow);
    margin-bottom: 24px;
    border-radius: 2px;
    box-shadow: 0 0 10px var(--aqua-glow);
  }

  .image-wrapper {
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    border: 2px solid var(--line);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  }

  .past-image {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.6s ease;
  }

  .image-wrapper:hover .past-image {
    transform: scale(1.02);
  }

  .present-image {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.6s ease;
  }

  .image-wrapper:hover .present-image {
    transform: scale(1.02);
  }

  .future-image {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.6s ease;
  }

  .image-wrapper:hover .future-image {
    transform: scale(1.02);
  }

  .paragraph {
    font-size: 1.15rem;
    line-height: 1.8;
    margin: 0;
    opacity: 0.9;
    text-align: justify;
    color: var(--ice-white);
    white-space: pre-line;
  }

  .mt-4 {
    margin-top: 1.5rem;
  }

  .bonus-button-container {
    text-align: center;
    margin-top: 40px;
    min-height: 50px;
  }

  .bonus-btn {
    background: transparent;
    border: 2px solid var(--aqua-glow);
    color: var(--aqua-glow);
    padding: 12px 30px;
    font-size: 1.1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border-radius: 30px;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 0 15px rgba(130, 232, 231, 0.3);
  }

  .bonus-btn:hover {
    background: var(--aqua-glow);
    color: #0d0d11;
    box-shadow: 0 0 25px var(--aqua-glow);
    transform: translateY(-2px);
  }

  .bonus-modal {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(10px);
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .bonus-modal.open {
    display: flex;
    opacity: 1;
  }

  .bonus-modal-content {
    background: #0d0d11;
    border: 2px solid var(--line);
    border-radius: 16px;
    width: 60%;
    max-width: 60%;
    position: relative;
    padding: 60px 30px 30px;
    text-align: center;
    box-shadow: 0 0 30px rgba(130, 232, 231, 0.15);
    transform: scale(0.9);
    transition: transform 0.4s ease;
    max-height: 85vh;
    overflow-y: auto;
  }

  @media (max-width: 768px) {
    .about-section {
      flex-direction: column !important;
      gap: 30px;
    }

    .media-column {
      width: 100%;
    }

    .about-container {
      gap: 60px;
    }

    .bonus-modal-content {
      width: 90%;
      max-width: 90%;
      padding: 50px 20px 20px;
    }
  }

  .bonus-modal-content::-webkit-scrollbar {
    width: 8px;
  }
  .bonus-modal-content::-webkit-scrollbar-track {
    background: #0d0d11;
  }
  .bonus-modal-content::-webkit-scrollbar-thumb {
    background: var(--line);
    border-radius: 4px;
  }
  .bonus-modal-content::-webkit-scrollbar-thumb:hover {
    background: var(--aqua-glow);
  }

  .bonus-modal.open .bonus-modal-content {
    transform: scale(1);
  }

  .bonus-modal-close {
    position: absolute;
    top: 15px;
    right: 20px;
    background: transparent;
    border: none;
    color: var(--coral-red, #FF747D);
    font-size: 2.2rem;
    line-height: 1;
    cursor: pointer;
    transition: transform 0.2s ease, color 0.2s ease;
    z-index: 10;
  }

  .bonus-modal-close:hover {
    transform: scale(1.1);
    color: #ff4d58;
  }

  .bonus-modal-image {
    max-width: 100%;
    max-height: 380px;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
    margin: 15px auto 20px;
    border-radius: 8px;
    border: 1px solid var(--line);
  }

  .bonus-modal-title {
    font-size: 2rem;
    color: var(--aqua-glow);
    margin: 0 0 10px;
    font-weight: normal;
  }

  .bonus-modal-divider {
    width: 60px;
    height: 3px;
    background: var(--aqua-glow);
    margin: 0 auto 20px;
  }

  .bonus-modal-text {
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--ice-white);
    opacity: 0.9;
    margin: 0;
    white-space: pre-line;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
