---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteNav from "@/components/SiteNav.astro";
import Footer from "@/components/Footer.astro";
import { getLandingContent, getMerchUrl, getBonusSettings } from "@/lib/db";
import { isLocale, type Locale, getLocalized } from "@/lib/i18n";

export const prerender = false;

const requestedLocale = Astro.params.locale;
if (!isLocale(requestedLocale)) {
  return Astro.redirect("/zh-TW/about");
}

const locale: Locale = requestedLocale;
const env = Astro.locals.runtime?.env;
const [landing, merchUrl, bonusSettings] = await Promise.all([
  getLandingContent(env),
  getMerchUrl(env, locale),
  getBonusSettings(env)
]);

const pastTitles = {
  en: "Past",
  "zh-TW": "過去",
  "zh-CN": "过去"
};

const presentTitles = {
  en: "Present",
  "zh-TW": "現在",
  "zh-CN": "现在"
};

const futureTitles = {
  en: "Future",
  "zh-TW": "未來",
  "zh-CN": "未来"
};

const pastText = {
  en: "Sam Lee's musical journey began with a passion that defined a generation. From his early debut to performing on stages worldwide, the past represents the foundation of his deep connection with fans through unforgettable classic love songs and albums. Over the years, his dedication to the art of singing and his distinct vocal tone has built a legacy that continues to resonate with listeners across all walks of life.",
  "zh-TW": "李聖傑的音樂旅程始於定義了一個世代的熱情。從早期的出道到在世界各地的舞台上演出，過去代表了他與樂迷之間深厚連結的基石，帶來無數令人難忘的經典情情歌與專輯。多年來，他對歌唱藝術的專注與獨特嗓音，鑄就了這段持續在所有聽眾心中共鳴的經典傳傳奇。",
  "zh-CN": "李圣杰的音乐旅程始于定义了一个世代的热情。从早期的出道到在世界各地的舞台上演出，过去代表了他与乐迷之间深厚联结的基石，带来无数令人难忘的经典情歌与专辑。多年来，他对歌唱艺术的专注与独特嗓音，铸就了这段持续在所有听众心中共鸣的经典传奇。"
};

const presentTextPart1 = {
  en: "Today, Sam Lee continues to evolve, pushing the boundaries of live performances and music production. With a passion that burns as bright as ever, he brings new life to the stage with every performance, capturing the hearts of old and new fans alike.",
  "zh-TW": "今天，李聖傑持續進化，推動現場演出與音樂製作的界限。憑藉著一如既往炙熱的熱情，他在每一次的演出中都為舞台注入全新的生命力，深深吸引著新舊樂迷的心。",
  "zh-CN": "今天，李圣杰持续进化，推动现场演出与音乐制作的界限。凭借着一如既往炙热的热情，他在每一次的演出中都为舞台注入全新的生命力，深深吸引着新旧乐迷的心。"
};

const presentTextPart2 = {
  en: "Through his independent label Zoommuzik, he is dedicated to delivering high-quality musical experiences. By blending traditional emotional ballads with modern sound production, he maintains a direct and heartfelt connection with audiences in the present moment.",
  "zh-TW": "透過他的獨立廠牌錞藝音樂，他致力於帶來高品質的音樂體驗。藉由將傳統的情感民謠與現代聲音製作融合，他在此時此刻與聽眾保持著最直接且真摯的連結。",
  "zh-CN": "透过他的独立厂牌錞艺音乐，他致力于带来高质量的音乐体验。藉由将传统的情感民谣与现代声音制作融合，他在此时此刻与听众保持着最直接且真挚的联结。"
};

const futureText = {
  en: "Looking ahead, the future shines bright with new creative visions, upcoming tour schedules, and technological integration. The journey ahead promises groundbreaking music projects and even closer bonds with fans around the globe. Guided by a commitment to musical excellence and innovation, Sam Lee is set to explore new genres and digital spaces, creating immersive experiences that will define the next chapter of his musical legacy.",
  "zh-TW": "展望未來，隨著全新的創作願景、即將公佈的巡演行程以及技術整合，未來散發著明亮的光芒。未來的旅程承諾將帶來突破性的音樂企劃，與全球樂迷建立更緊密的連結。在對音樂卓越與創新的承諾指引下，李聖傑將探索新的音樂風格與數位空間，創造出定義他音樂生涯下一章節的沉浸式體驗。",
  "zh-CN": "展望未来，随着全新的创作愿景、即将公布的巡演行程以及技术整合，未来散发着明亮的光芒。未来的旅程承诺将带来突破性的音乐企划，与全球乐迷建立更紧密的联结。在对音乐卓越与创新的承诺指引下，李圣杰将探索新的音乐风格与数位空间，创造出定义他音乐生涯下一章节的沉浸式体验。"
};

const bonusTitle = getLocalized(bonusSettings?.title, locale);
const bonusText = getLocalized(bonusSettings?.text, locale);
const bonusImageUrl = bonusSettings?.imageUrl || "";
---

<BaseLayout locale={locale} title={`Sam Lee | About`}>
  <SiteNav locale={locale} merchUrl={merchUrl} />
  <main class="page-main">
    <div class="about-container">
      
      <!-- Past Section -->
      <section class="about-section direction-row">
        <div class="media-column">
          <div class="image-wrapper">
            <img src="/assets/about/about_debut.jpg" alt="Sam Lee Past Journey" class="past-image" />
          </div>
        </div>
        <div class="text-column">
          <h2 class="section-title">{pastTitles[locale]}</h2>
          <div class="section-divider"></div>
          <p class="paragraph">{pastText[locale]}</p>
        </div>
      </section>

      <!-- Present Section -->
      <section class="about-section direction-row-reverse">
        <div class="media-column">
          <div class="image-wrapper">
            <img src="/assets/about/about_tennis.jpg" alt="Sam Lee Present Journey" class="present-image" />
          </div>
        </div>
        <div class="text-column">
          <h2 class="section-title">{presentTitles[locale]}</h2>
          <div class="section-divider"></div>
          <p class="paragraph">{presentTextPart1[locale]}</p>
          <p class="paragraph mt-4">{presentTextPart2[locale]}</p>
        </div>
      </section>

      <!-- Future Section -->
      <section class="about-section direction-row">
        <div class="media-column">
          <div class="neon-punk-container">
            <img src="/assets/about/about_venture.jpg" alt="Sam Lee Future Journey" class="future-image" />
          </div>
        </div>
        <div class="text-column">
          <h2 class="section-title">{futureTitles[locale]}</h2>
          <div class="section-divider"></div>
          <p class="paragraph">{futureText[locale]}</p>
        </div>
      </section>

      {bonusTitle && (
        <div class="bonus-button-container">
          <button id="bonus-btn" class="bonus-btn" style="display: none;">Extra bonus</button>
        </div>
      )}
    </div>

    {bonusTitle && (
      <div id="bonus-modal" class="bonus-modal">
        <div class="bonus-modal-content">
          <button id="bonus-modal-close" class="bonus-modal-close" aria-label="Close">&times;</button>
          {bonusImageUrl && <img src={bonusImageUrl} alt={bonusTitle} class="bonus-modal-image" />}
          <h2 class="bonus-modal-title">{bonusTitle}</h2>
          <div class="bonus-modal-divider"></div>
          <p class="bonus-modal-text">{bonusText}</p>
        </div>
      </div>
    )}
  </main>
  <Footer locale={locale} socialLinks={landing.socialLinks} />
</BaseLayout>

<script>
  const bonusBtn = document.getElementById("bonus-btn");
  const bonusModal = document.getElementById("bonus-modal");
  const bonusClose = document.getElementById("bonus-modal-close");

  let timer: number | null = null;
  let isTimerRunning = false;
  let hasLeftBottomSinceClose = true;

  function checkScroll() {
    const windowHeight = window.innerHeight;
    const scrollY = window.scrollY;
    const documentHeight = document.documentElement.scrollHeight;
    
    // Check if scrolled to the bottom (within 15px threshold)
    const isAtBottom = (windowHeight + scrollY) >= (documentHeight - 15);

    if (isAtBottom) {
      if (!isTimerRunning && hasLeftBottomSinceClose && bonusBtn && bonusBtn.style.display === "none" && bonusModal && !bonusModal.classList.contains("open")) {
        isTimerRunning = true;
        timer = window.setTimeout(() => {
          if (bonusBtn) {
            bonusBtn.style.display = "inline-block";
            bonusBtn.style.animation = "fadeIn 0.5s ease forwards";
          }
          isTimerRunning = false;
        }, 10000); // 10 seconds
      }
    } else {
      if (isTimerRunning) {
        if (timer) clearTimeout(timer);
        isTimerRunning = false;
      }
      if (bonusBtn && bonusBtn.style.display === "none" && bonusModal && !bonusModal.classList.contains("open")) {
        hasLeftBottomSinceClose = true;
      }
    }
  }

  window.addEventListener("scroll", checkScroll);
  // Initial check on load
  checkScroll();

  bonusBtn?.addEventListener("click", () => {
    if (bonusModal) {
      bonusModal.classList.add("open");
    }
  });

  bonusClose?.addEventListener("click", () => {
    if (bonusModal) {
      bonusModal.classList.remove("open");
    }
    if (bonusBtn) {
      bonusBtn.style.display = "none";
    }
    if (timer) {
      clearTimeout(timer);
      timer = null;
    }
    isTimerRunning = false;
    hasLeftBottomSinceClose = false;
  });
</script>

<style>
  .page-main {
    padding-top: 120px;
    min-height: 80vh;
    background: transparent;
    color: var(--ice-white);
  }

  .about-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 40px 24px 80px;
    display: flex;
    flex-direction: column;
    gap: 80px;
  }

  .about-section {
    display: flex;
    align-items: center;
    gap: 60px;
  }

  .direction-row {
    flex-direction: row;
  }

  .direction-row-reverse {
    flex-direction: row-reverse;
  }

  .media-column {
    flex: 0 0 40%;
    width: 40%;
  }

  .text-column {
    flex: 1;
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: normal;
    letter-spacing: -0.02em;
    color: var(--aqua-glow);
    text-transform: uppercase;
    margin: 0 0 16px;
  }

  .section-divider {
    width: 80px;
    height: 4px;
    background: var(--aqua-glow);
    margin-bottom: 24px;
    border-radius: 2px;
    box-shadow: 0 0 10px var(--aqua-glow);
  }

  .image-wrapper {
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    border: 2px solid var(--line);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  }

  .past-image {
    width: 100%;
    height: auto;
    display: block;
    filter: grayscale(100%);
    transition: transform 0.6s ease;
  }

  .image-wrapper:hover .past-image {
    transform: scale(1.02);
  }

  .present-image {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.6s ease;
  }

  .image-wrapper:hover .present-image {
    transform: scale(1.02);
  }

  .neon-punk-container {
    position: relative;
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    border: 2px solid var(--line);
    box-shadow: 0 0 20px rgba(130, 232, 231, 0.2), 0 10px 30px rgba(0, 0, 0, 0.5);
    background: #0d0d11;
  }

  .future-image {
    width: 100%;
    height: auto;
    display: block;
    filter: grayscale(100%) contrast(1.4) brightness(0.85);
    transition: transform 0.6s ease;
  }

  .neon-punk-container::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(130, 232, 231, 0.8), rgba(255, 116, 125, 0.8));
    mix-blend-mode: color;
    pointer-events: none;
  }

  .neon-punk-container::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--aqua-glow), var(--coral-red));
    mix-blend-mode: overlay;
    opacity: 0.4;
    pointer-events: none;
    z-index: 2;
  }

  .neon-punk-container:hover .future-image {
    transform: scale(1.02);
  }

  .paragraph {
    font-size: 1.15rem;
    line-height: 1.8;
    margin: 0;
    opacity: 0.9;
    text-align: justify;
    color: var(--ice-white);
  }

  .mt-4 {
    margin-top: 1.5rem;
  }

  .bonus-button-container {
    text-align: center;
    margin-top: 40px;
    min-height: 50px;
  }

  .bonus-btn {
    background: transparent;
    border: 2px solid var(--aqua-glow);
    color: var(--aqua-glow);
    padding: 12px 30px;
    font-size: 1.1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border-radius: 30px;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 0 15px rgba(130, 232, 231, 0.3);
  }

  .bonus-btn:hover {
    background: var(--aqua-glow);
    color: #0d0d11;
    box-shadow: 0 0 25px var(--aqua-glow);
    transform: translateY(-2px);
  }

  .bonus-modal {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(10px);
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .bonus-modal.open {
    display: flex;
    opacity: 1;
  }

  .bonus-modal-content {
    background: #0d0d11;
    border: 2px solid var(--line);
    border-radius: 16px;
    width: 60%;
    max-width: 60%;
    position: relative;
    padding: 60px 30px 30px;
    text-align: center;
    box-shadow: 0 0 30px rgba(130, 232, 231, 0.15);
    transform: scale(0.9);
    transition: transform 0.4s ease;
    max-height: 85vh;
    overflow-y: auto;
  }

  @media (max-width: 768px) {
    .about-section {
      flex-direction: column !important;
      gap: 30px;
    }

    .media-column {
      width: 100%;
    }

    .about-container {
      gap: 60px;
    }

    .bonus-modal-content {
      width: 90%;
      max-width: 90%;
      padding: 50px 20px 20px;
    }
  }

  .bonus-modal-content::-webkit-scrollbar {
    width: 8px;
  }
  .bonus-modal-content::-webkit-scrollbar-track {
    background: #0d0d11;
  }
  .bonus-modal-content::-webkit-scrollbar-thumb {
    background: var(--line);
    border-radius: 4px;
  }
  .bonus-modal-content::-webkit-scrollbar-thumb:hover {
    background: var(--aqua-glow);
  }

  .bonus-modal.open .bonus-modal-content {
    transform: scale(1);
  }

  .bonus-modal-close {
    position: absolute;
    top: 15px;
    right: 20px;
    background: transparent;
    border: none;
    color: var(--coral-red, #FF747D);
    font-size: 2.2rem;
    line-height: 1;
    cursor: pointer;
    transition: transform 0.2s ease, color 0.2s ease;
    z-index: 10;
  }

  .bonus-modal-close:hover {
    transform: scale(1.1);
    color: #ff4d58;
  }

  .bonus-modal-image {
    max-width: 100%;
    max-height: 380px;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
    margin: 15px auto 20px;
    border-radius: 8px;
    border: 1px solid var(--line);
  }

  .bonus-modal-title {
    font-size: 2rem;
    color: var(--aqua-glow);
    margin: 0 0 10px;
    font-weight: normal;
  }

  .bonus-modal-divider {
    width: 60px;
    height: 3px;
    background: var(--aqua-glow);
    margin: 0 auto 20px;
  }

  .bonus-modal-text {
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--ice-white);
    opacity: 0.9;
    margin: 0;
    white-space: pre-line;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
