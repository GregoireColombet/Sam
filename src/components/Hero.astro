---
const env = Astro.locals.runtime?.env;
const mediaBase = env?.PUBLIC_MEDIA_BASE_URL || "/media";
const videoUrl = `${mediaBase.replace(/\/$/, "")}/hero-video.mp4`;
---

<section class="hero" aria-label="Sam Lee">
  <video class="hero-video" autoplay muted loop playsinline poster="/hero-poster.jpg">
    <source src={videoUrl} type="video/mp4" />
  </video>
  <div class="hero-shade"></div>
  <div class="hero-content">
    <img class="hero-logo" src="/assets/logo_white.png" alt="Sam Lee" />
  </div>
</section>

<style>
  .hero {
    position: relative;
    margin-top: calc(var(--header-height, 72px) - 1px);
    display: block;
    width: 100%;
    height: calc(100vh - var(--header-height, 72px) + 1px);
    height: calc(100dvh - var(--header-height, 72px) + 1px);
    overflow: hidden;
    background: transparent;
    line-height: 0;
    font-size: 0;
  }

  .hero-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
    background: transparent;
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-content {
    position: absolute;
    inset: 0;
    z-index: 1;
    text-align: center;
    padding: 24px;
    display: flex;
    justify-content: center;
    align-items: center;
    pointer-events: none;
  }

  .hero-logo {
    max-width: min(80vw, 640px);
    height: auto;
    display: block;
    filter: drop-shadow(0 0 25px rgba(130, 232, 231, 0.3));
  }
</style>
