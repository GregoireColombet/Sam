---
const env = Astro.locals.runtime?.env;
const mediaBase = env?.PUBLIC_MEDIA_BASE_URL || "/media";
const videoUrl = `${mediaBase.replace(/\/$/, "")}/hero-video.mp4`;
---

<section class="hero" aria-label="Sam Lee">
  <video class="hero-video" autoplay muted loop playsinline poster="/hero-poster.jpg">
    <source src={videoUrl} type="video/mp4" />
  </video>
  <div class="hero-shade"></div>
  <div class="hero-content">
    <img class="hero-logo" src="/assets/logo_white.png" alt="Sam Lee" />
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: #080808;
  }

  .hero-video,
  .hero-shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-video {
    object-fit: cover;
  }

  .hero-shade {
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.1) 50%, #0F1418 100%),
      radial-gradient(circle at 50% 44%, rgba(130, 232, 231, 0.25), transparent 45%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 96px 24px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-logo {
    max-width: min(80vw, 640px);
    height: auto;
    display: block;
    filter: drop-shadow(0 0 25px rgba(130, 232, 231, 0.3));
  }
</style>
