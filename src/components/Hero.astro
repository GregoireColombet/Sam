---
const env = Astro.locals.runtime?.env;
const mediaBase = env?.PUBLIC_MEDIA_BASE_URL || "/media";
const videoUrl = `${mediaBase.replace(/\/$/, "")}/hero-video.mp4`;
---

<section class="hero" aria-label="Sam Lee">
  <video class="hero-video" autoplay muted loop playsinline poster="/hero-poster.jpg">
    <source src={videoUrl} type="video/mp4" />
  </video>
  <div class="hero-shade"></div>
  <div class="hero-content">
    <img class="hero-logo" src="/assets/logo_white.png" alt="Sam Lee" />
  </div>
</section>

<style>
  .hero {
    position: relative;
    margin-top: 72px;
    min-height: calc(100svh - 72px);
    display: grid;
    place-items: center;
    overflow: hidden;
    background: #080808;
  }

  .hero-video,
  .hero-shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-video {
    object-fit: cover;
  }

  .hero-shade {
    background:
      /* Smooth fade from the page background color (--bg / #0F1418) at the bottom up into transparency */
      linear-gradient(to top, var(--bg) 0%, rgba(15, 20, 24, 0.9) 15%, rgba(15, 20, 24, 0) 50%),
      /* Top-down dark vignette */
      linear-gradient(180deg, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0) 50%),
      /* Center radial accent light */
      radial-gradient(circle at 50% 44%, rgba(130, 232, 231, 0.25), transparent 45%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 96px 24px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-logo {
    max-width: min(80vw, 640px);
    height: auto;
    display: block;
    filter: drop-shadow(0 0 25px rgba(130, 232, 231, 0.3));
  }
</style>
