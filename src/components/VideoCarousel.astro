---
import { labels, getLocalizedVideoUrl, type Locale } from "@/lib/i18n";
import type { VideoLink } from "@/lib/types";

type Props = {
  locale: Locale;
  videos: VideoLink[];
};

const { locale, videos } = Astro.props;
const t = labels[locale];
---

<section class="section videos">
  <div class="container">
    <h2 class="section-title">{t.video}</h2>
    {videos.length === 0 ? (
      <div class="empty-state">{t.videoComingSoon}</div>
    ) : (
      <div class:list={["carousel-wrapper", { "is-single": videos.length === 1 }]}>
        {videos.length > 1 && (
          <button class="carousel-arrow prev" data-carousel-prev aria-label="Previous videos" type="button">◀</button>
        )}
        <div class:list={["video-strip", { "is-single": videos.length === 1 }]}>
          {videos.map((video) => (
            <button class="video-card" data-video-url={getLocalizedVideoUrl(video, locale)} data-video-title={video.title} type="button">
              <span class="video-img-wrapper">
                {video.thumbnail ? (
                  <img src={video.thumbnail.url} alt={video.thumbnail.alt || video.title} loading="lazy" />
                ) : (
                  <span class="no-thumb">{video.title}</span>
                )}
                <span class="play-icon" aria-hidden="true">▶</span>
              </span>
              <strong>{video.title}</strong>
            </button>
          ))}
        </div>
        {videos.length > 1 && (
          <button class="carousel-arrow next" data-carousel-next aria-label="Next videos" type="button">▶</button>
        )}
      </div>
    )}
  </div>
</section>

<!-- Lightbox Modal -->
<div class="video-lightbox" id="video-lightbox" aria-hidden="true" role="dialog">
  <div class="lightbox-overlay" id="lightbox-overlay"></div>
  <button class="lightbox-nav prev" id="lightbox-prev" type="button" aria-label="Previous video">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
  </button>
  <div class="lightbox-content">
    <button class="lightbox-close" id="lightbox-close" type="button" aria-label="Close video player">&times;</button>
    <div class="iframe-container" id="iframe-container"></div>
  </div>
  <button class="lightbox-nav next" id="lightbox-next" type="button" aria-label="Next video">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
  </button>
</div>

<script src="./video-carousel.client.ts"></script>

<style>
  .videos {
    position: relative;
    z-index: 1;
    width: 100%;
    margin: 0 auto;
    padding: 108px 0 48px;
    background: transparent;
  }

  .videos :global(.section-title) {
    margin-bottom: 70px;
  }

  .carousel-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
  }

  .carousel-arrow {
    background: transparent;
    border: none;
    color: var(--aqua-glow);
    font-size: 2rem;
    cursor: pointer;
    padding: 8px;
    z-index: 10;
    transition: transform 180ms ease, opacity 180ms ease, text-shadow 180ms ease, filter 180ms ease;
    opacity: 0.85;
    line-height: 1;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.45);
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.4));
    user-select: none;
  }

  .carousel-arrow:hover {
    transform: scale(1.2);
    opacity: 1;
    text-shadow: 0 0 10px var(--aqua-glow), 0 2px 8px rgba(0, 0, 0, 0.4);
    filter: drop-shadow(0 0 10px var(--aqua-glow)) drop-shadow(0 2px 6px rgba(0, 0, 0, 0.35));
  }

  .carousel-wrapper.is-single {
    justify-content: center;
  }

  .video-strip {
    flex: 1;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(280px, 38%);
    gap: 20px;
    overflow-x: auto;
    padding-bottom: 20px;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    scrollbar-color: var(--aqua-glow) transparent;
  }

  .video-strip.is-single {
    display: flex;
    justify-content: center;
    grid-auto-columns: unset;
    overflow-x: visible;
  }

  .video-strip.is-single .video-card {
    width: 100%;
    max-width: 480px;
  }

  .video-card {
    scroll-snap-align: start;
    display: grid;
    gap: 14px;
    background: transparent;
    border: none;
    padding: 0;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }

  .video-img-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: rgba(15, 20, 24, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid var(--line);
    border-radius: 8px;
    display: grid;
    place-items: center;
    overflow: hidden;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.4);
    transition: border-color 220ms ease, box-shadow 220ms ease;
  }

  .video-card:hover .video-img-wrapper {
    border-color: var(--aqua-glow);
    box-shadow: 0 0 16px rgba(130, 232, 231, 0.3);
  }

  .video-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms ease, filter 300ms ease;
  }

  .video-card:hover img {
    transform: scale(1.04);
    filter: brightness(0.85);
  }

  .no-thumb {
    font-size: 0.95rem;
    color: var(--text-muted);
    text-align: center;
    padding: 12px;
  }

  .play-icon {
    position: absolute;
    z-index: 2;
    background: rgba(0, 0, 0, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #fff;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 1.15rem;
    padding-left: 3px;
    opacity: 0.8;
    transition: all 220ms ease;
  }

  .video-card:hover .play-icon {
    opacity: 1;
    transform: scale(1.1);
    background: var(--dark);
    color: var(--aqua-glow);
    border-color: var(--aqua-glow);
    box-shadow: 0 0 15px rgba(130, 232, 231, 0.4);
  }

  .video-card strong {
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.4;
    color: var(--ice-white);
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.85);
    transition: color 220ms ease;
  }

  .video-card:hover strong {
    color: var(--coral-red);
  }

  /* Lightbox Styles */
  .video-lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 220ms ease;
    padding: 24px;
  }

  .video-lightbox.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .lightbox-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.96);
    backdrop-filter: blur(12px);
  }

  .lightbox-content {
    position: relative;
    z-index: 101;
    width: min(90vw, 960px);
    aspect-ratio: 16 / 9;
    background: #000;
    border: 2px solid var(--cyan);
    box-shadow: 0 0 35px rgba(75, 187, 196, 0.4), 0 0 80px rgba(75, 187, 196, 0.15);
  }

  .lightbox-nav {
    position: relative;
    z-index: 102;
    background: rgba(0, 0, 0, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #fff;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 220ms ease;
  }

  .lightbox-nav:hover {
    background: rgba(0, 0, 0, 0.8);
    border-color: var(--pink);
    color: var(--pink);
    box-shadow: 0 0 12px var(--pink);
    transform: scale(1.08);
  }

  .lightbox-nav svg {
    width: 24px;
    height: 24px;
    stroke: currentColor;
  }

  .iframe-container {
    width: 100%;
    height: 100%;
  }

  .iframe-container iframe {
    width: 100%;
    height: 100%;
  }

  .lightbox-close {
    position: absolute;
    top: -44px;
    right: 0;
    background: transparent;
    border: none;
    color: #fff;
    font-size: 2.2rem;
    cursor: pointer;
    line-height: 1;
    opacity: 0.7;
    transition: opacity 180ms ease, color 180ms ease;
  }

  .lightbox-close:hover {
    opacity: 1;
    color: var(--pink);
  }

  @media (max-width: 760px) {
    .video-strip {
      grid-auto-columns: minmax(240px, 84%);
      gap: 16px;
    }
    
    .video-lightbox {
      padding: 12px;
      gap: 12px;
    }

    .lightbox-content {
      width: min(92vw, 640px);
    }

    .lightbox-nav {
      width: 38px;
      height: 38px;
    }

    .lightbox-nav svg {
      width: 18px;
      height: 18px;
    }

    .lightbox-close {
      top: -38px;
      right: 6px;
    }
  }
</style>
