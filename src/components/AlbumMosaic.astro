---
import { labels, type Locale } from "@/lib/i18n";
import type { AlbumCover } from "@/lib/types";

type Props = {
  locale: Locale;
  albums: AlbumCover[];
  singles: AlbumCover[];
};

const { locale, albums, singles } = Astro.props;
const t = labels[locale];
---

<section class="section albums album-section">
  <div class="container">
    <h2 class="section-title">{t.music}</h2>
    {albums.length === 0 ? (
      <div class="empty-state">{t.albumComingSoon}</div>
    ) : (
      <div class="album-carousel-wrapper" data-carousel="albums" tabindex="0" role="region" aria-label={t.music}>
        <button class="carousel-arrow prev" data-carousel-prev aria-label="Previous album" type="button">◀</button>
        <div class="album-carousel-viewport">
          <div class="album-carousel-track" data-carousel-track>
            {albums.map((album) => (
              <button 
                class="album-card" 
                data-title={album.title}
                data-image={album.image.url}
                data-links={JSON.stringify(album.links || [])}
                data-date={album.productionDate}
                aria-label={album.title}
                type="button"
              >
                <img src={album.image.url} alt={album.image.alt || album.title} loading="lazy" />
              </button>
            ))}
          </div>
        </div>
        <button class="carousel-arrow next" data-carousel-next aria-label="Next album" type="button">▶</button>
      </div>
    )}
  </div>
</section>

<section class="section albums single-section" style="padding-top: 60px;">
  <div class="container">
    <h2 class="section-title">{t.single}</h2>
    {singles.length === 0 ? (
      <div class="empty-state">{t.albumComingSoon}</div>
    ) : (
      <div class="album-carousel-wrapper" data-carousel="singles" tabindex="0" role="region" aria-label={t.single}>
        <button class="carousel-arrow prev" data-carousel-prev aria-label="Previous single" type="button">◀</button>
        <div class="album-carousel-viewport">
          <div class="album-carousel-track" data-carousel-track>
            {singles.map((single) => (
              <button 
                class="album-card" 
                data-title={single.title}
                data-image={single.image.url}
                data-links={JSON.stringify(single.links || [])}
                data-date={single.productionDate}
                aria-label={single.title}
                type="button"
              >
                <img src={single.image.url} alt={single.image.alt || single.title} loading="lazy" />
              </button>
            ))}
          </div>
        </div>
        <button class="carousel-arrow next" data-carousel-next aria-label="Next single" type="button">▶</button>
      </div>
    )}
  </div>
</section>

<!-- Overlay Modal for custom platform links -->
<div id="album-overlay-modal" class="album-overlay" aria-hidden="true" role="dialog">
  <div class="album-modal-backdrop"></div>
  <div class="album-modal-wrapper">
    <div class="album-modal-box">
      <button class="album-modal-close-btn" aria-label="Close modal">&times;</button>
      <div class="album-modal-content">
        <div class="album-modal-left">
          <img id="modal-album-img" src="" alt="Album Cover" />
          <h3 id="modal-album-title-text"></h3>
          <div id="modal-album-date-text" style="font-size: 0.9rem; color: var(--text-muted); font-weight: 500; margin-top: -8px;"></div>
        </div>
        <div class="album-modal-right">
          <h4 class="modal-platform-header">{t.choosePlatform}</h4>
          <div id="modal-platform-links-grid" class="platform-links-grid">
            <!-- Dynamically populated buttons -->
          </div>
          <div id="modal-no-links-msg" class="no-links-message" style="display: none;">
            {t.musicComingSoon}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Modal Management
  const modal = document.getElementById("album-overlay-modal");
  const backdrop = modal?.querySelector(".album-modal-backdrop");
  const closeBtn = modal?.querySelector(".album-modal-close-btn");
  const modalImg = document.getElementById("modal-album-img") as HTMLImageElement;
  const modalTitle = document.getElementById("modal-album-title-text");
  const linksGrid = document.getElementById("modal-platform-links-grid");
  const noLinksMsg = document.getElementById("modal-no-links-msg");
  const modalDate = document.getElementById("modal-album-date-text");

  function openModal(title: string, image: string, links: any[], date: string) {
    if (!modal) return;
    
    if (modalImg) {
      modalImg.src = image;
      modalImg.alt = title;
    }
    if (modalTitle) {
      modalTitle.textContent = `Title: ${title}`;
    }
    if (modalDate) {
      const year = date ? date.split("-")[0] : "";
      modalDate.textContent = year ? `Release date: ${year}` : "";
    }

    if (linksGrid) {
      linksGrid.innerHTML = "";
      if (links && links.length > 0) {
        if (noLinksMsg) noLinksMsg.style.display = "none";
        linksGrid.style.display = "grid";
        
        links.forEach((link: any) => {
          const btn = document.createElement("a");
          btn.className = "platform-btn";
          btn.href = link.url;
          btn.target = "_blank";
          btn.rel = "noopener noreferrer";
          
          btn.innerHTML = `
            ${link.logo?.url ? `<img src="${link.logo.url}" alt="${link.name}" class="platform-icon" />` : ""}
            <span class="platform-name">${link.name}</span>
          `;
          linksGrid.appendChild(btn);
        });
      } else {
        linksGrid.style.display = "none";
        if (noLinksMsg) noLinksMsg.style.display = "block";
      }
    }

    modal.setAttribute("aria-hidden", "false");
    modal.classList.add("show");
    document.body.style.overflow = "hidden";
  }

  function closeModal() {
    if (!modal) return;
    modal.setAttribute("aria-hidden", "true");
    modal.classList.remove("show");
    document.body.style.overflow = "";
  }

  closeBtn?.addEventListener("click", closeModal);
  backdrop?.addEventListener("click", closeModal);

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && modal?.classList.contains("show")) {
      closeModal();
    }
  });

  // Carousel Controller Class
  class CarouselController {
    wrapper: HTMLElement;
    viewport: HTMLElement;
    track: HTMLElement;
    prevBtn: HTMLElement | null;
    nextBtn: HTMLElement | null;
    originalCards: HTMLElement[];
    totalOriginal: number;
    cloneBuffer: number = 0;
    allCards: HTMLElement[] = [];
    currentIndex: number = 0;
    isTransitioning: boolean = false;
    gap: number = 24;
    slideWidth: number = 0;
    isMobile: boolean = false;

    // Touch support
    touchStartX: number = 0;
    touchEndX: number = 0;

    constructor(wrapper: HTMLElement) {
      this.wrapper = wrapper;
      this.viewport = wrapper.querySelector(".album-carousel-viewport") as HTMLElement;
      this.track = wrapper.querySelector("[data-carousel-track]") as HTMLElement;
      this.prevBtn = wrapper.querySelector("[data-carousel-prev]");
      this.nextBtn = wrapper.querySelector("[data-carousel-next]");
      
      this.originalCards = Array.from(this.track.querySelectorAll(".album-card")) as HTMLElement[];
      this.totalOriginal = this.originalCards.length;
      
      if (this.totalOriginal === 0) return;

      if (this.totalOriginal === 1) {
        if (this.prevBtn) this.prevBtn.style.display = "none";
        if (this.nextBtn) this.nextBtn.style.display = "none";
        this.track.style.justifyContent = "center";
        this.attachCardClick(this.originalCards[0]);
        return;
      }

      // Build clone buffer (at least 4 clones on each side so 2.5 visible items are always filled)
      this.cloneBuffer = Math.max(4, this.totalOriginal);
      this.setupClones();
      this.currentIndex = this.cloneBuffer;

      this.updateDimensions();
      this.applyTransform(false);

      this.bindEvents();
    }

    setupClones() {
      // Create head clones (elements before index 0)
      const headClones: HTMLElement[] = [];
      for (let i = 0; i < this.cloneBuffer; i++) {
        const itemIndex = ((this.totalOriginal - ((this.cloneBuffer - i) % this.totalOriginal)) % this.totalOriginal);
        const clone = this.originalCards[itemIndex].cloneNode(true) as HTMLElement;
        clone.classList.add("carousel-clone");
        headClones.push(clone);
      }

      // Create tail clones (elements after index totalOriginal - 1)
      const tailClones: HTMLElement[] = [];
      for (let i = 0; i < this.cloneBuffer; i++) {
        const itemIndex = i % this.totalOriginal;
        const clone = this.originalCards[itemIndex].cloneNode(true) as HTMLElement;
        clone.classList.add("carousel-clone");
        tailClones.push(clone);
      }

      // Clear track and insert all
      this.track.innerHTML = "";
      headClones.forEach(c => this.track.appendChild(c));
      this.originalCards.forEach(c => this.track.appendChild(c));
      tailClones.forEach(c => this.track.appendChild(c));

      this.allCards = Array.from(this.track.querySelectorAll(".album-card")) as HTMLElement[];
      this.allCards.forEach(card => this.attachCardClick(card));
    }

    attachCardClick(card: HTMLElement) {
      card.addEventListener("click", () => {
        const title = card.getAttribute("data-title") || "";
        const image = card.getAttribute("data-image") || "";
        const date = card.getAttribute("data-date") || "";
        let links: any[] = [];
        try {
          links = JSON.parse(card.getAttribute("data-links") || "[]");
        } catch (e) {
          console.error(e);
        }
        openModal(title, image, links, date);
      });
    }

    updateDimensions() {
      if (!this.viewport) return;
      const viewportWidth = this.viewport.clientWidth;
      this.isMobile = window.innerWidth <= 768;
      this.gap = this.isMobile ? 16 : 24;

      if (this.isMobile) {
        this.slideWidth = viewportWidth;
      } else {
        // Desktop: 2 full pictures + 0.25 peek left + 0.25 peek right = 2.5 picture units + 3 gaps
        this.slideWidth = (viewportWidth - 3 * this.gap) / 2.5;
      }

      this.allCards.forEach(card => {
        card.style.width = `${this.slideWidth}px`;
        card.style.marginRight = `${this.gap}px`;
      });
    }

    getOffsetForIndex(index: number): number {
      if (this.isMobile) {
        return - index * (this.slideWidth + this.gap);
      } else {
        // In desktop mode:
        // Visible items: [0.25 of item (index-1)] [gap] [item index] [gap] [item index+1] [gap] [0.25 of item (index+2)]
        // Viewport starts 0.25 * slideWidth into item (index-1)
        const peekWidth = 0.25 * this.slideWidth;
        return peekWidth + this.gap - index * (this.slideWidth + this.gap);
      }
    }

    applyTransform(animated: boolean) {
      if (animated) {
        this.track.style.transition = "transform 320ms cubic-bezier(0.25, 1, 0.5, 1)";
      } else {
        this.track.style.transition = "none";
      }
      const offset = this.getOffsetForIndex(this.currentIndex);
      this.track.style.transform = `translate3d(${offset}px, 0, 0)`;
    }

    next() {
      if (this.isTransitioning) return;
      this.isTransitioning = true;
      this.currentIndex++;
      this.applyTransform(true);
    }

    prev() {
      if (this.isTransitioning) return;
      this.isTransitioning = true;
      this.currentIndex--;
      this.applyTransform(true);
    }

    handleTransitionEnd() {
      this.isTransitioning = false;

      // Wrap around seamlessly
      if (this.currentIndex >= this.cloneBuffer + this.totalOriginal) {
        this.currentIndex -= this.totalOriginal;
        this.applyTransform(false);
      } else if (this.currentIndex < this.cloneBuffer) {
        this.currentIndex += this.totalOriginal;
        this.applyTransform(false);
      }
    }

    bindEvents() {
      this.prevBtn?.addEventListener("click", () => this.prev());
      this.nextBtn?.addEventListener("click", () => this.next());

      this.track.addEventListener("transitionend", (e) => {
        if (e.target === this.track) {
          this.handleTransitionEnd();
        }
      });

      // Resize observer
      const resizeObserver = new ResizeObserver(() => {
        this.updateDimensions();
        this.applyTransform(false);
      });
      resizeObserver.observe(this.viewport);

      // Keyboard accessibility
      this.wrapper.addEventListener("keydown", (e) => {
        if (e.key === "ArrowLeft") {
          e.preventDefault();
          this.prev();
        } else if (e.key === "ArrowRight") {
          e.preventDefault();
          this.next();
        }
      });

      // Touch / Swipe support
      this.viewport.addEventListener("touchstart", (e) => {
        this.touchStartX = e.changedTouches[0].screenX;
      }, { passive: true });

      this.viewport.addEventListener("touchend", (e) => {
        this.touchEndX = e.changedTouches[0].screenX;
        const diff = this.touchStartX - this.touchEndX;
        if (Math.abs(diff) > 40) {
          if (diff > 0) {
            this.next();
          } else {
            this.prev();
          }
        }
      }, { passive: true });
    }
  }

  // Initialize all carousels on page
  const carouselWrappers = document.querySelectorAll(".album-carousel-wrapper");
  carouselWrappers.forEach((wrapper) => {
    new CarouselController(wrapper as HTMLElement);
  });
</script>

<style>
  .albums {
    background: transparent;
    width: 100%;
    margin: 0 auto;
    padding: 108px 0 48px;
  }

  .album-section {
    background: transparent;
  }

  .single-section {
    background: transparent;
    padding-bottom: 128px;
  }

  .albums :global(.section-title) {
    margin-bottom: 70px;
  }

  /* Carousel Structure */
  .album-carousel-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    max-width: 1000px;
    margin: 0 auto;
    outline: none;
  }

  .album-carousel-wrapper:focus-visible {
    outline: 2px solid var(--aqua-glow);
    outline-offset: 8px;
    border-radius: 8px;
  }

  .carousel-arrow {
    background: transparent;
    border: none;
    color: var(--aqua-glow);
    font-size: 2rem;
    cursor: pointer;
    padding: 8px;
    z-index: 10;
    transition: transform 180ms ease, opacity 180ms ease;
    opacity: 0.8;
    line-height: 1;
    flex-shrink: 0;
    user-select: none;
  }

  .carousel-arrow:hover {
    transform: scale(1.2);
    opacity: 1;
    text-shadow: 0 0 8px var(--aqua-glow);
  }

  .album-carousel-viewport {
    flex: 1;
    overflow: hidden;
    position: relative;
    /* Vertical padding compensation so card hover scale/shadow isn't clipped by overflow: hidden */
    padding: 24px 0;
    margin: -24px 0;
  }

  .album-carousel-track {
    display: flex;
    align-items: center;
    width: max-content;
    will-change: transform;
    user-select: none;
  }

  .album-card {
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    aspect-ratio: 1;
    display: block;
    outline: none;
    flex-shrink: 0;
    position: relative;
  }

  .album-card img {
    width: 100%;
    height: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 6px;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.5);
    filter: saturate(0.9);
    display: block;
    pointer-events: none;
    transition:
      transform 250ms cubic-bezier(0.4, 0, 0.2, 1),
      filter 250ms cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow 250ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .album-card:hover img,
  .album-card:focus img {
    transform: scale(1.05) translateY(-3px);
    filter: saturate(1.2) contrast(1.1);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.7), 0 0 16px rgba(130, 232, 231, 0.4);
    position: relative;
    z-index: 10;
  }

  @media (max-width: 768px) {
    .album-carousel-wrapper {
      gap: 6px;
    }

    .carousel-arrow {
      font-size: 1.6rem;
      padding: 4px;
    }
  }

  /* Overlay Modal System */
  .album-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2000;
    display: none;
    align-items: center;
    justify-content: center;
  }

  .album-overlay.show {
    display: flex;
  }

  .album-modal-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(10, 10, 12, 0.85);
    backdrop-filter: blur(8px);
  }

  .album-modal-wrapper {
    position: relative;
    z-index: 10;
    width: 90%;
    max-width: 680px;
    animation: zoomIn 300ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .album-modal-box {
    background: linear-gradient(135deg, #1c1c24 0%, #121218 100%);
    border: 1px solid rgba(130, 232, 231, 0.25);
    border-radius: 12px;
    padding: 32px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
    position: relative;
  }

  .album-modal-close-btn {
    position: absolute;
    top: 16px;
    right: 16px;
    background: none;
    border: none;
    color: var(--ice-white);
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
    opacity: 0.7;
    transition: opacity 0.2s, transform 0.2s;
    outline: none;
  }

  .album-modal-close-btn:hover {
    opacity: 1;
    transform: scale(1.1);
  }

  .album-modal-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    align-items: center;
  }

  @media (max-width: 600px) {
    .album-modal-content {
      grid-template-columns: 1fr;
      gap: 24px;
      text-align: center;
    }
  }

  .album-modal-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    width: 100%;
    max-width: 240px;
    margin: 0 auto;
  }

  .album-modal-left img {
    width: 100%;
    max-width: 240px;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 6px;
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .album-modal-left h3 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--ice-white);
    letter-spacing: 0.5px;
  }

  .album-modal-right {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .modal-platform-header {
    margin: 0 0 6px 0;
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--text-muted);
    border-bottom: 1px solid rgba(130, 232, 231, 0.2);
    padding-bottom: 8px;
  }

  .platform-links-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    max-height: 250px;
    overflow-y: auto;
    padding-top: 8px;
    padding-right: 4px;
  }

  /* Premium scrollbar styling */
  .platform-links-grid::-webkit-scrollbar {
    width: 6px;
  }
  .platform-links-grid::-webkit-scrollbar-track {
    background: transparent;
  }
  .platform-links-grid::-webkit-scrollbar-thumb {
    background: rgba(130, 232, 231, 0.3);
    border-radius: 4px;
  }

  :global(.platform-btn) {
    display: flex;
    align-items: center;
    gap: 16px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 12px 16px;
    color: var(--ice-white);
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s, transform 0.2s;
    font-weight: 600;
    font-size: 0.95rem;
  }

  :global(.platform-btn:hover) {
    background: rgba(130, 232, 231, 0.1);
    border-color: rgba(130, 232, 231, 0.6);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(130, 232, 231, 0.15);
  }

  :global(.platform-icon) {
    width: 20px;
    height: 20px;
    object-fit: contain;
    display: block;
  }

  :global(.platform-name) {
    line-height: 1;
    display: inline-flex;
    align-items: center;
  }

  .no-links-message {
    color: var(--text-muted);
    font-style: italic;
    font-size: 0.95rem;
    text-align: center;
    padding: 16px 0;
  }

  @keyframes zoomIn {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
</style>
