---
import { labels, localePath, type Locale } from "@/lib/i18n";
import type { AlbumCover } from "@/lib/types";

type Props = {
  locale: Locale;
  albums: AlbumCover[];
};

const { locale, albums } = Astro.props;
const t = labels[locale];
---

<section class="section albums">
  <div class="container">
    <h2 class="section-title">{t.music}</h2>
    {albums.length === 0 ? (
      <div class="empty-state">{t.albumComingSoon}</div>
    ) : (
      <a class="mosaic" href={localePath(locale, "/music")} aria-label={t.music}>
        {albums.map((album) => (
          <img src={album.image.url} alt={album.image.alt || album.title} loading="lazy" />
        ))}
      </a>
    )}
  </div>
</section>

<style>
  .albums {
    background: var(--night-graphite);
    width: calc(100% - 4px);
    margin: 0 auto;
    padding: 48px 24px;
    border-left: 1px solid rgba(130, 232, 231, 0.4);
    border-right: 1px solid rgba(130, 232, 231, 0.4);
    border-top: none;
    border-bottom: none;
  }

  @media (min-width: 768px) {
    .albums {
      width: calc(100% - 2 * clamp(34px, 5vw, 100px));
    }
  }

  .albums :global(.container) {
    width: 100%;
    max-width: none;
  }

  .mosaic {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 16px;
  }

  .mosaic img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    filter: saturate(0.85);
    transition:
      transform 250ms cubic-bezier(0.4, 0, 0.2, 1),
      filter 250ms cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow 250ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .mosaic img:hover {
    transform: scale(1.04) translateY(-2px);
    filter: saturate(1.2) contrast(1.1);
    box-shadow: 0 8px 24px rgba(250, 250, 250, 0.5), 0 0 12px rgba(250, 250, 250, 0.3);
    position: relative;
    z-index: 10;
  }

  @media (max-width: 520px) {
    .mosaic {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
  }
</style>
