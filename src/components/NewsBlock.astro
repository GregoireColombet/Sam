---
import { labels, getLocalized, type Locale } from "@/lib/i18n";
import type { NewsBlock } from "@/lib/types";

type Props = {
  locale: Locale;
  news: NewsBlock;
};

const { locale, news } = Astro.props;
const title = getLocalized(news.title, locale);
const body = getLocalized(news.body, locale);
const t = labels[locale];
---

<section class="news section">
  <div class={`container news-content ${news.background ? 'has-image' : ''}`}>
    <div class="news-text">
      <p class="eyebrow">News</p>
      <h2>{title}</h2>
      <p>{body}</p>
    </div>
    {news.background && (
      <div class="news-image-container">
        <img src={news.background.url} alt={news.background.alt || title} class="news-image" />
      </div>
    )}
  </div>
  {news.countdownAtUtc && (
    <div class="countdown-container">
      <div class="countdown" data-countdown={news.countdownAtUtc}>
        <span><strong data-days>0</strong>{t.days}</span>
        <span><strong data-hours>0</strong>{t.hours}</span>
        <span><strong data-minutes>0</strong>{t.minutes}</span>
      </div>
    </div>
  )}
</section>

<script>
  const countdown = document.querySelector("[data-countdown]");
  if (countdown) {
    const target = new Date(countdown.getAttribute("data-countdown") || "").getTime();
    const update = () => {
      const diff = Math.max(0, target - Date.now());
      const totalMinutes = Math.floor(diff / 60000);
      const days = Math.floor(totalMinutes / 1440);
      const hours = Math.floor((totalMinutes % 1440) / 60);
      const minutes = totalMinutes % 60;
      countdown.querySelector("[data-days]")!.textContent = String(days);
      countdown.querySelector("[data-hours]")!.textContent = String(hours);
      countdown.querySelector("[data-minutes]")!.textContent = String(minutes);
    };
    update();
    window.setInterval(update, 1000);
  }
</script>

<style>
  .news {
    position: relative;
    background: var(--night-graphite);
    overflow: hidden;
    width: calc(100% - 4px);
    margin: 0 auto;
    padding: 48px 24px;
    border-left: 1px solid rgba(130, 232, 231, 0.4);
    border-right: 1px solid rgba(130, 232, 231, 0.4);
    border-top: none;
    border-bottom: none;
  }

  @media (min-width: 768px) {
    .news {
      width: calc(100% - 2 * clamp(34px, 5vw, 100px));
    }
  }

  .news :global(.container) {
    width: 100%;
    max-width: none;
  }

  .news-content {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }

  @media (min-width: 768px) {
    .news-content.has-image {
      grid-template-columns: 3fr 2fr;
    }
  }

  .news-image-container {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }

  .news-image {
    width: 100%;
    height: auto;
    max-height: 400px;
    object-fit: contain;
    border-radius: 8px;
    border: 1px solid rgba(130, 232, 231, 0.2);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3);
  }

  .eyebrow {
    margin: 0 0 12px;
    color: var(--coral-red);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  h2 {
    max-width: 780px;
    margin: 0;
    font-size: clamp(2.2rem, 6vw, 6rem);
    line-height: 0.92;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--aqua-glow);
  }

  p {
    max-width: 680px;
    color: var(--ice-white);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .countdown-container {
    display: flex;
    justify-content: center;
    margin-top: 40px;
    width: 100%;
  }

  .countdown {
    display: grid;
    grid-template-columns: repeat(3, minmax(84px, 1fr));
    gap: 12px;
  }

  .countdown span {
    min-width: 86px;
    padding: 14px;
    border: 1px solid var(--line);
    background: var(--night-graphite);
    text-align: center;
    color: var(--text-muted);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    transition: border-color 200ms ease;
  }

  .countdown span:hover {
    border-color: var(--aqua-glow);
  }

  .countdown strong {
    display: block;
    color: var(--aqua-glow);
    font-size: 2.2rem;
    font-weight: 900;
    text-shadow: 0 0 8px rgba(130, 232, 231, 0.4);
  }
</style>
