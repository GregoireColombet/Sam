---
import { labels, getLocalized, type Locale } from "@/lib/i18n";
import type { NewsBlock } from "@/lib/types";

type Props = {
  locale: Locale;
  news: NewsBlock;
};

const { locale, news } = Astro.props;
const title = getLocalized(news.title, locale);
const body = getLocalized(news.body, locale);
const t = labels[locale];
---

<section class="news section">
  <div class={`container news-content ${news.background ? 'has-image' : ''}`}>
    <div class="news-text news-header">
      <p class="eyebrow">News</p>
      <h2>{title}</h2>
    </div>

    {news.background && (
      <div class="news-image-container">
        <img src={news.background.url} alt={news.background.alt || title} class="news-image" />
      </div>
    )}

    {body && (
      <div class="news-body">
        <p>{body}</p>
      </div>
    )}

    {news.countdownAtUtc && (
      <div class="countdown-container">
        <div class="countdown" data-countdown={news.countdownAtUtc}>
          <span><strong data-days>0</strong>{t.days}</span>
          <span><strong data-hours>0</strong>{t.hours}</span>
          <span><strong data-minutes>0</strong>{t.minutes}</span>
        </div>
      </div>
    )}
  </div>
</section>

<script>
  const countdown = document.querySelector("[data-countdown]");
  if (countdown) {
    const target = new Date(countdown.getAttribute("data-countdown") || "").getTime();
    const update = () => {
      const diff = Math.max(0, target - Date.now());
      const totalMinutes = Math.floor(diff / 60000);
      const days = Math.floor(totalMinutes / 1440);
      const hours = Math.floor((totalMinutes % 1440) / 60);
      const minutes = totalMinutes % 60;
      countdown.querySelector("[data-days]")!.textContent = String(days);
      countdown.querySelector("[data-hours]")!.textContent = String(hours);
      countdown.querySelector("[data-minutes]")!.textContent = String(minutes);
    };
    update();
    window.setInterval(update, 1000);
  }
</script>

<style>
  .news {
    position: relative;
    background-color: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    overflow: hidden;
    width: calc(100% - 60px);
    max-width: var(--max);
    margin: 0px auto;
    margin-top: 108px;
    padding: 44px 0;
    border-radius: 16px;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.4);
  }

  .news-content {
    display: grid;
    gap: 28px;
    align-items: center;
  }

  .news-content.has-image {
    grid-template-columns: 1.1fr 0.9fr;
    grid-template-areas:
      "header image"
      "body   body"
      "timer  timer";
  }

  .news-content:not(.has-image) {
    grid-template-columns: 1fr;
    grid-template-areas:
      "header"
      "body"
      "timer";
  }

  .news-header {
    grid-area: header;
  }

  .news-image-container {
    grid-area: image;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }

  .news-image {
    width: 100%;
    height: auto;
    max-height: 380px;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: none;
  }

  .news-body {
    grid-area: body;
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .news-body p {
    max-width: 820px;
    margin: 0 auto;
    color: #ffffff;
    font-size: 1.05rem;
    line-height: 1.7;
    text-align: left;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
    white-space: pre-line;
  }

  .countdown-container {
    grid-area: timer;
    display: flex;
    justify-content: center;
    width: 100%;
  }

  @media (max-width: 768px) {
    .news {
      margin-top: 24px;
      padding: 28px 0;
      width: calc(100% - 40px);
    }

    .news-content {
      gap: 20px;
    }

    .news-content.has-image {
      grid-template-columns: 1fr;
      grid-template-areas:
        "header"
        "body"
        "image"
        "timer";
    }

    .news-content:not(.has-image) {
      grid-template-columns: 1fr;
      grid-template-areas:
        "header"
        "body"
        "timer";
    }

    .news-body p {
      font-size: 1rem;
      line-height: 1.6;
    }

    .news-image {
      max-height: 280px;
    }
  }

  .eyebrow {
    margin: 0 0 12px;
    color: var(--coral-red);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
  }

  h2 {
    max-width: 780px;
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 3.8rem);
    line-height: 1.15;
    font-weight: normal;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-align: center;
    color: var(--ice-white);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.7), 0 0 20px rgba(130, 232, 231, 0.25);
  }

  .countdown {
    display: flex;
    justify-content: center;
    gap: clamp(16px, 4vw, 36px);
  }

  .countdown span {
    min-width: 70px;
    padding: 0 8px;
    background: transparent;
    border: none;
    box-shadow: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    text-align: center;
    color: var(--ice-white);
    font-size: 0.95rem;
    font-weight: 600;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
    transition: transform 200ms ease;
  }

  .countdown span:hover {
    transform: translateY(-2px);
  }

  .countdown strong {
    display: block;
    color: var(--aqua-glow);
    font-size: 2.2rem;
    font-weight: 900;
    text-shadow: 0 0 10px rgba(130, 232, 231, 0.5);
    margin-bottom: 2px;
  }
</style>
