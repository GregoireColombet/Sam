          </a>
        {%- endif -%}
      </div>

    </div>

    {%- if section.settings.show_legal_bar -%}
      <div class="sl-footer-bottom">
        <div class="sl-copyright">
          &copy; {{ 'now' | date: '%Y' }} {{ shop.name | default: 'Sam Lee' }}. {{ section.settings.copyright_text | default: 'All rights reserved.' }}
        </div>
        {%- if section.settings.footer_menu != blank -%}
          <ul class="sl-footer-bottom-links">
            {%- for link in linklists[section.settings.footer_menu].links -%}
