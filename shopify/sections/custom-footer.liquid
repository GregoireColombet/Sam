{% comment %}
  =============================================================================
  Sam Lee Marketing Footer for Shopify (Horizon & OS 2.0 Themes)
  Matches exact layout, styling, colors, and behavior of https://www.samleemuzik.com
  =============================================================================
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Chiron+GoRound+TC:wght@200..900&family=Syncopate:wght@400&family=Inter:wght@400;500;700;800&display=swap" rel="stylesheet">

{%- style -%}
  .sl-footer-{{ section.id }} {
    position: relative;
    z-index: 10;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    border-top: 1px solid {{ section.settings.border_color }};
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    font-family: "Chiron GoRound TC", "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    width: 100%;
    box-sizing: border-box;
  }

  .sl-footer-{{ section.id }} * {
    box-sizing: border-box;
  }

  .sl-footer-container {
    width: min(100% - 32px, 1160px);
    margin-inline: auto;
  }

  .sl-footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .sl-footer-left {
    display: flex;
    align-items: center;
    gap: 40px;
    flex-wrap: wrap;
  }

  .sl-footer-brand {
    display: flex;
    align-items: center;
    font-weight: 900;
    text-transform: uppercase;
  }

  .sl-footer-logo-img {
    height: {{ section.settings.logo_height }}px;
    width: auto;
    max-width: 220px;
    display: block;
    object-fit: contain;
    {% if section.settings.invert_logo %}
      filter: invert(1) brightness(1.2);
    {% endif %}
  }

  .sl-footer-logo-svg {
    height: {{ section.settings.logo_height }}px;
    width: auto;
    display: block;
  }

  .sl-zoommuzik-info {
    display: flex;
    flex-direction: column;
    gap: 6px;
    border-left: 1px solid {{ section.settings.border_color }};
    padding-left: 24px;
  }

  .sl-zoommuzik-logo-img {
    height: {{ section.settings.zoommuzik_logo_height }}px;
    width: auto;
    max-width: 180px;
    align-self: flex-start;
    object-fit: contain;
    margin-bottom: 2px;
    {% if section.settings.invert_zoommuzik_logo %}
      filter: invert(1) brightness(1.2);
    {% endif %}
  }

  .sl-mention {
    font-size: 0.8rem;
    color: {{ section.settings.muted_text_color }};
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    line-height: 1.2;
  }

  .sl-contact-link {
    font-size: 0.85rem;
    color: {{ section.settings.accent_color }};
    transition: color 150ms ease, text-shadow 150ms ease;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    line-height: 1.2;
    display: inline-block;
  }

  .sl-contact-link:hover {
    color: {{ section.settings.glow_color }};
    text-shadow: 0 0 8px rgba(130, 232, 231, 0.6);
    text-decoration: none;
  }

  .sl-socials {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 14px;
  }

  .sl-social-link {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    text-decoration: none;
    color: inherit;
    transition: transform 180ms ease;
    border-radius: 4px;
  }

  .sl-social-link img,
  .sl-social-link svg {
    width: 30px;
    height: 30px;
    object-fit: contain;
    fill: currentColor;
    color: #FAFAFA;
    transition: filter 200ms ease, transform 200ms ease;
  }

  .sl-social-link:hover img,
  .sl-social-link:hover svg {
    filter: brightness(0) saturate(100%) invert(80%) sepia(35%) saturate(735%) hue-rotate(130deg) brightness(97%) contrast(98%) drop-shadow(0 0 8px rgba(130, 232, 231, 0.8));
    transform: scale(1.08);
  }

  /* Optional e-commerce policies bar */
  .sl-footer-bottom {
    margin-top: 24px;
    padding-top: 18px;
    border-top: 1px solid rgba(130, 232, 231, 0.1);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 0.75rem;
    color: {{ section.settings.muted_text_color }};
  }

  .sl-footer-bottom-links {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sl-footer-bottom-links a {
    color: {{ section.settings.muted_text_color }};
    text-decoration: none;
    transition: color 150ms ease;
  }

  .sl-footer-bottom-links a:hover {
    color: {{ section.settings.glow_color }};
  }

  @media (max-width: 640px) {
    .sl-footer-inner {
      align-items: stretch;
      flex-direction: column;
      gap: 28px;
    }

    .sl-footer-left {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
    }

    .sl-zoommuzik-info {
      border-left: none;
      padding-left: 0;
      border-top: 1px solid {{ section.settings.border_color }};
      padding-top: 16px;
      width: 100%;
    }

    .sl-socials {
      justify-content: flex-start;
    }

    .sl-footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
  }
{%- endstyle -%}

<footer class="sl-footer sl-footer-{{ section.id }}" role="contentinfo">
  <div class="sl-footer-container">
    <div class="sl-footer-inner">
      <div class="sl-footer-left">
        
        <!-- Brand Logo (Sam Lee) -->
        <div class="sl-footer-brand">
          <a href="{{ routes.root_url }}" aria-label="{{ shop.name | default: 'Sam Lee' }}">
            {%- if section.settings.logo != blank -%}
              {{ section.settings.logo | image_url: width: 400 | image_tag: 
                class: 'sl-footer-logo-img', 
                alt: section.settings.logo.alt | default: 'Sam Lee', 
                loading: 'lazy' 
              }}
            {%- else -%}
              <!-- Default vector SAM LEE Logo SVG -->
              <svg class="sl-footer-logo-svg" viewBox="0 0 1600 520" fill="none" stroke="#FFFFFF" stroke-width="14" stroke-linecap="square" stroke-linejoin="round" aria-hidden="true">
                <path d="M325 155 H145 Q120 155 120 180 Q120 205 145 205 H275 Q300 205 300 230 Q300 255 275 255 H120"/>
                <path d="M405 285 L485 155 L565 285"/>
                <path d="M650 285 V155 L735 235 L820 155 V285"/>
                <path d="M965 155 V285 H1105"/>
                <path d="M1195 165 H1325"/>
                <path d="M1195 220 H1325"/>
                <path d="M1195 275 H1325"/>
                <path d="M1400 165 H1530"/>
                <path d="M1400 220 H1530"/>
                <path d="M1400 275 H1530"/>
              </svg>
            {%- endif -%}
          </a>
        </div>

        <!-- Zoommuzik Info & Business Inquiries -->
        <div class="sl-zoommuzik-info">
          {%- if section.settings.zoommuzik_logo != blank -%}
            {{ section.settings.zoommuzik_logo | image_url: width: 300 | image_tag: 
              class: 'sl-zoommuzik-logo-img', 
              alt: 'Zoommuzik', 
              loading: 'lazy' 
            }}
          {%- else -%}
            <!-- Fallback text / logo if no image uploaded -->
            <div style="font-weight: 800; font-size: 1.1rem; letter-spacing: 0.08em; color: #FFFFFF; text-transform: uppercase;">
              ZOOMMUZIK
            </div>
          {%- endif -%}

          {%- if section.settings.production_text != blank -%}
            <span class="sl-mention">{{ section.settings.production_text }}</span>
          {%- endif -%}

          {%- if section.settings.contact_email != blank -%}
            <a class="sl-contact-link" href="mailto:{{ section.settings.contact_email }}">
              {{ section.settings.contact_label | default: 'Contact for business inquiries' }}
            </a>
          {%- endif -%}
        </div>

      </div>

      <!-- Social Media Links -->
      <div class="sl-socials" aria-label="Social links">
